          <path d="M1 8 Q6 1 12 7 Q18 1 23 8" />
        </svg>
      ))}

      <svg class="meadow" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMin slice">
        <defs>
          <linearGradient id="grass" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#c9e2a6" />
            <stop offset="0.5" stop-color="#bcd99a" />
