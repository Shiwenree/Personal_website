      <!-- Flowers on their own layer, so their movement doesn't repaint the blurred grass underneath.
           Each ruffles when the gust reaches its x position. -->
      <svg class="meadow" viewBox="0 0 1600 900" preserveAspectRatio="xMidYMin slice">
        {flowerPatches.map((patch) => (
          <g class="rustle" fill={patch.color} style={`--delay: ${n(gustDelay(patch.x))}s`}>
            {patch.dots.map(([x, y, r]) => <circle cx={n(x)} cy={n(y)} r={n(r)} />)}
          </g>
        ))}


        {daisies.map((f) => (
          <g transform={`translate(${n(f.x)} ${n(f.y)}) scale(${n(f.s)})`}>
            <g class="ruffle" style={`--delay: ${n(gustDelay(f.x))}s`}>
              <path class="stem" d="M0 0 V16" />
              {daisyPetals.map((angle) => (
                <ellipse class="petal" cx="0" cy="-4.6" rx="2.4" ry="4" transform={`rotate(${angle})`} />
              ))}
              <circle r="2.5" fill="#f3c55c" />
            </g>
          </g>
        ))}

      </svg>

      <!-- A soft gust of light rolling across the meadow every so often, like wind over grass -->
      <div class="gust"></div>

      <!-- Big foreground plants swaying in the bottom corners -->
      <svg class="front left" viewBox="0 0 160 120">
        <g class="ruffle" style="--delay: 1s">
          <path class="stem" d="M40 120 Q36 80 44 52" />
          <path class="leaf" d="M40 100 q-22 -4 -28 -22 q20 2 28 18 Z" />
          <circle class="bloom" cx="44" cy="48" r="11" />
          <path d="M38 47 q6 7 12 0" fill="none" stroke="#d98477" stroke-width="1.2" />
        </g>
        <g class="ruffle" style="--delay: 1.15s">
          <path class="stem" d="M96 120 Q100 92 94 72" />
          {daisyPetals.map((angle) => (
            <ellipse class="petal" cx="94" cy="62" rx="3.6" ry="6.4" transform={`rotate(${angle} 94 68)`} />
          ))}
          <circle cx="94" cy="68" r="4" fill="#f3c55c" />
        </g>
      </svg>
      <svg class="front right" viewBox="0 0 160 120">
        <g class="ruffle" style="--delay: 4.5s">
          <path class="stem" d="M60 120 Q66 84 58 56" />
          {daisyPetals.map((angle) => (
            <ellipse class="petal" cx="58" cy="46" rx="3.8" ry="6.8" transform={`rotate(${angle} 58 52)`} />
          ))}
          <circle cx="58" cy="52" r="4.2" fill="#f3c55c" />
        </g>
        <g class="ruffle" style="--delay: 4.65s">
          <path class="stem" d="M118 120 Q114 96 122 74" />
          <path class="leaf" d="M118 104 q20 -4 26 -20 q-18 2 -26 16 Z" />
          <circle class="bloom" cx="122" cy="70" r="10" />
          <path d="M116 69 q6 6 12 0" fill="none" stroke="#d98477" stroke-width="1.2" />
        </g>
      </svg>

      <!-- Faint paper grain for the watercolor feel -->
      <svg class="grain">
        <filter id="grain">
          <feTurbulence type="fractalNoise" baseFrequency="0.8" numOctaves="2" stitchTiles="stitch" />
          <feColorMatrix values="0 0 0 0 0.35  0 0 0 0 0.3  0 0 0 0 0.25  0 0 0 0.6 0" />
        </filter>
        <rect width="100%" height="100%" filter="url(#grain)" />
      </svg>
    </div>

    <!-- ---------- Content, lined up with the rest of the page ---------- -->
    <div class="field-inner">
      <div class="projects-col">
      <!-- Project buttons. Once one is opened, they shrink into tabs along the left edge of the page. -->
      <ul class="list">
        {works.map((work, i) => (
          <li>
            <button
              type="button"
              class="work"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls={`detail-${i}`}
              data-index={i}
              data-title={work.title}
              data-sign={work.title.split(' – ')[0]}
              data-villager={work.villager}
              aria-label={work.title}
              style={`--work: ${work.color}`}
            >
              <span
                class:list={['swatch', { 'has-face': work.villager }]}
                aria-hidden="true"
                style={work.villager && `background-image: url(${faceUrl(work.villager)})`}
              ></span>
              <span class="short" aria-hidden="true">P{i + 1}</span>
              <span class="text">
                <span class="title">{work.title}</span>
                <span class="tag">{work.tag}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>

      <!-- Text box about the opened project (one per project; the script shows the right one) -->
      {works.map((work, i) => (
        <article class="detail" id={`detail-${i}`} data-detail={i} aria-labelledby={`detail-title-${i}`} style={`--work: ${work.color}`} hidden>
          <button type="button" class="back" data-back>← All projects</button>
          <h2 class="detail-title" id={`detail-title-${i}`} tabindex="-1">{work.title}</h2>
          <p class="detail-summary">{work.summary}</p>
          <ul class="chips">
            {work.tags.map((t) => <li class="chip">{t}</li>)}
