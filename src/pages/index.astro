---
import BaseLayout from '../layouts/BaseLayout.astro';
import { villagers } from '../data/villagers';
import { roles } from '../data/roles';
import '@fontsource/baloo-2/800.css'; // rounded font for the villager's name under its spot
import { statSync } from 'node:fs';
import { cloud, puffInk } from '../data/thought-cloud';

// Face icons get "?v=<when the file last changed>" on the end, so browsers fetch a redrawn face
// instead of showing the old one they saved earlier
const faceUrl = (key: string) => {
  const file = `/villagers/${key}-face.webp`;
  return `${file}?v=${Math.round(statSync(`public${file}`).mtimeMs)}`;
};

// Placeholder projects. Later these come from the projects content collection, and each one
// gets its villager avatar (shown standing in the meadow on the right) and a link to its project page.
// `villager` is a key from src/data/villagers.ts. `summary` and `tags` show in the text box that opens
// when a project is clicked, under the optional `subtitle`. Titles can read "Name: what it is"; the signpost shows just the name.
// `href` adds a "View project" link to its project page, and `github` adds a "GitHub" link.
// `sign` overrides what the signpost says (for long names).
type Work = { title: string; sign?: string; subtitle?: string; tag: string; color: string; villager?: string; summary: string; tags: string[]; href?: string; github?: string };
const works: Work[] = [
  {
    title: 'SIFT: Scoring PRs by Real Work',
    subtitle: 'An explainable score for every pull request',
    tag: 'Personal build',
    color: '#e9b49a',
    villager: 'sammy',
    summary:
      'Companies often judge engineers by how many pull requests they merge, but AI makes that count easy to inflate. SIFT is a Python pipeline that gives each PR one score for the meaningful work in it. It filters out noise like bots, lockfiles and reverts, sorts each commit with free rule checks first and Claude Haiku only for what the rules can’t decide, and records why every commit landed where it did, so any score can be explained or disputed.',
    tags: ['Python', 'GitHub API', 'Claude API', 'Metric design'],
    href: '/works/sift',
    github: 'https://github.com/Shiwenree/PR-Project',
  },
  {
    title: 'Circular Action Alliance',
    sign: 'CAA',
    subtitle: 'LLM checks on self-reported packaging data',
    tag: 'Client project · Atlas Digital',
    color: '#a9c4d6',
    villager: 'duck',
    summary:
      'Under packaging recycling laws, producers self-report the packaging they sell, and Circular Action Alliance (CAA) has to trust it. As Lead Analyst on a 7-person team, I helped build an LLM pipeline that rebuilds each producer’s packaging from public sources so it can be checked against what they reported. I built the packaging classification with strict structured outputs, a baseline matched against about 6,500 reported rows, and a bill of materials for each packaging type. We ran it on 89 producers.',
    tags: ['LLM pipelines', 'OpenAI API', 'Structured outputs', 'Data validation'],
    href: '/works/caa',
  },
  {
    title: 'GreenLight: Engagement Tracker',
    subtitle: 'Turning relationship work into a system',
    tag: 'Client project · 180 Degrees',
    color: '#b9c99a',
    villager: 'foxy',
    summary:
      'GreenLight Fund Detroit’s relationships with investors, residents and partners lived mostly in people’s heads. I co-led a 6-person 180 Degrees Consulting team that delivered two playbooks, a community survey strategy, and an engagement tracker web app (React, Supabase, Vercel) that a small team without engineers can keep running.',
    tags: ['React', 'Supabase', 'Tailwind CSS', 'Figma', 'Project management'],
    href: '/works/greenlight',
  },
  {
    title: 'Atlas Digital: Email Generator',
    sign: 'Email',
    subtitle: 'Finds recruiters and drafts the email',
    tag: 'Club tool · Atlas Digital',
    color: '#9fd0cf',
    villager: 'fish',
    summary:
      'A tool in Atlas Digital’s member portal that finds recruiters for a company and drafts a personalized outreach email for members to review before sending. I built the front end in React and Tailwind CSS. It serves 100+ members and raised recruiter follow-up rates by 40%.',
    tags: ['React', 'Tailwind CSS', 'Firebase', 'OpenAI API', 'Apollo API'],
    href: '/works/email',
  },
  {
    title: 'U-M ITS: Systems Analyst Intern',
    subtitle: 'Legacy-system RFPs and PM template fixes',
    tag: 'Internship · Summer 2025',
    color: '#d4b3d1',
    villager: 'owl',
    summary:
      'At University of Michigan ITS, I drafted the two RFPs vendors will bid on to replace Pinnacle, an aging billing and work-order system, after two months of user interviews and hands-on testing. I also led a 7-person intern cohort that made the Project Management Office’s most-used templates more accessible (up to +15%) and easier for AI to read (up to +52%).',
    tags: ['Requirements gathering', 'RFPs', 'Accessibility (WCAG)', 'Stakeholder interviews'],
    href: '/works/its',
  },
  {
    title: 'Settl: Pricing a Bed in Seconds',
    subtitle: 'Profit-safe price options for sales agents',
    tag: 'Client project · 180 Degrees',
    color: '#e6cf8f',
    villager: 'python',
    summary:
      'Settl is an Indian co-living company with more than 3,400 apartments, and its sales agents priced every bed by hand. Our 180 Degrees Consulting team built a full-stack calculator (Flask, SQL, JavaScript) that returns two or three price options tied to profit levels, so agents can negotiate without dropping below a margin floor. It cut manual calculation time by 50% for more than 30 agents.',
    tags: ['Python', 'Flask', 'SQL', 'JavaScript', 'Figma'],
    href: '/works/settl',
  },
];

// The signpost shows only the project's name: the part before ":" or " – "
const signName = (title: string) => title.split(/:| – /)[0];
const first = works[0].villager ? villagers[works[0].villager] : undefined;

// Everything else, shown as a simple grid under the meadow (no project pages for these yet).
// Add an `href` to make a card a link (e.g. to GitHub or a live demo), and a `status` (like
// "In progress") to show a little badge above the title. Each card has an animal face (public/villagers/more/,
// colored from the sketches in the "Meet the villagers" video) on a colored square; projects still in
// progress get a grayed-out villager with a question mark.
const moreProjects: { title: string; status?: string; blurb: string; tags: string[]; href?: string; face: string; color: string }[] = [
  {
    title: 'This Website',
    face: 'otter-face',
    color: '#b9c99a',
    blurb: 'A hand-painted village built in Astro: a living WebGL painting, sprite-animated villagers, and a pet that walks the page.',
    tags: ['Astro', 'TypeScript', 'WebGL', 'Illustration'],
  },
  {
    title: 'Medical Startup Homepage',
    face: 'deer-face',
    color: '#a9c4d6',
    blurb: 'A homepage for a medical startup, chosen over 25 competing developers and deployed to 200+ users.',
    tags: ['React', 'JavaScript', 'Tailwind CSS'],
  },
  {
    title: 'Photo Booth Strip',
    status: 'In progress',
    face: 'mystery-giraffe',
    color: '#e6cf8f',
    blurb: 'Snap a few photos and get them back as a classic photo booth strip.',
    tags: ['TBD'],
  },
  {
    title: 'Math Homework Notes',
    status: 'In progress',
    face: 'mystery-cat',
    color: '#d4b3d1',
    blurb: 'A notes app built for working through math homework.',
    tags: ['TBD'],
  },
];

// ---------- Scenery ----------
// The backdrop is a hand-drawn painting (Backgrounds/Works_background.png). scripts/build-works-scene.mjs
// splits it into the layers in public/works/, and the script at the bottom of this page brings them to life:
// the clouds drift, the trees and flowers bend when the breeze passes, and the lake ripples.
// Each file gets "?v=<when it last changed>" so browsers fetch a new painting instead of an old saved one.
const sceneUrl = (name: string) => {
  const file = `/works/${name}`;
  return `${file}?v=${Math.round(statSync(`public${file}`).mtimeMs)}`;
};
const scene = {
  painting: sceneUrl('painting.webp'),
  land: sceneUrl('land.webp'),
  sky: sceneUrl('sky.webp'),
  motion: sceneUrl('motion.png'),
};

// Birds, in the painting's ink. Positions are % of the painting. The two that wander in slow loops start
// where the painted birds are; the others fly across the sky lower down.
const wanderers = [
  { top: 4.4, left: 43, size: 0.95, duration: 19, delay: -3 },
  { top: 7.8, left: 45.8, size: 1, duration: 17, delay: -11 },
];
const birds = [
  { top: 15, size: 0.9, duration: 50, delay: -12 },
  { top: 21, size: 0.7, duration: 64, delay: -40 },
];
---

<BaseLayout title="Works · Reewin Shi">
  <!-- Greeting: who this is, then straight into the projects -->
  <header class="hello">
    <div>
      <h1>Hi, I'm Reewin!</h1>
      <p class="intro">Pick a project to meet its villager.</p>
    </div>
    <div class="about-me">
      <ul class="roles">
        {roles.map((r) => (
          <li>
            {r.role} @ <strong>{r.org}</strong>
            {r.when && <span class="when">· {r.when}</span>}
          </li>
        ))}
      </ul>
    </div>
  </header>

  <section class="field" data-works aria-label="Projects">
    <!-- ---------- Scenery (decorative) ---------- -->
    <div class="backdrop" aria-hidden="true">
      <!-- The painting, shown as-is until the animated version (the canvas) is ready, or for good when
           the visitor prefers less motion -->
      <div class="scene" data-scene data-land={scene.land} data-sky={scene.sky} data-motion={scene.motion}>
        <img class="painting" src={scene.painting} alt="" decoding="async" />
        <canvas class="live" data-live></canvas>

        <!-- A soft gust of light rolling across the meadow; the trees and flowers bend as it passes -->
        <div class="gust" data-gust></div>

        {birds.map((b) => (
          <svg class="bird" viewBox="0 0 24 10" style={`--top: ${b.top}%; --s: ${b.size}; --d: ${b.duration}s; --delay: ${b.delay}s`}>
            <path d="M1.5 3 Q7 0 12 8.5 Q17 0 22.5 3" />
          </svg>
        ))}
        {wanderers.map((b) => (
          <svg class="bird wander" viewBox="0 0 24 10" style={`--top: ${b.top}%; --left: ${b.left}%; --s: ${b.size}; --d: ${b.duration}s; --delay: ${b.delay}s`}>
            <path d="M1.5 3 Q7 0 12 8.5 Q17 0 22.5 3" />
          </svg>
        ))}
      </div>
    </div>

    <!-- ---------- Content, lined up with the rest of the page ---------- -->
    <div class="field-inner">
      <div class="projects-col">
      <!-- Project buttons. Once one is opened, they shrink into tabs along the left edge of the page. -->
      <ul class="list">
        {works.map((work, i) => (
          <li>
            <button
              type="button"
              class="work"
              aria-pressed={i === 0 ? 'true' : 'false'}
              aria-controls={`detail-${i}`}
              data-index={i}
              data-title={work.title}
              data-sign={work.sign ?? signName(work.title)}
              data-villager={work.villager}
              aria-label={work.title}
              style={`--work: ${work.color}`}
            >
              <span
                class:list={['swatch', { 'has-face': work.villager }]}
                aria-hidden="true"
                style={work.villager && `background-image: url(${faceUrl(work.villager)})`}
              ></span>
              <span class="short" aria-hidden="true">P{i + 1}</span>
              <span class="text">
                <span class="title">{work.title}</span>
                {work.subtitle && <span class="subtitle">{work.subtitle}</span>}
                <span class="tag">{work.tag}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>

      <!-- Text box about the opened project (one per project; the script shows the right one) -->
      {works.map((work, i) => (
        <article class="detail" id={`detail-${i}`} data-detail={i} aria-labelledby={`detail-title-${i}`} style={`--work: ${work.color}`} hidden>
          <button type="button" class="back" data-back>← All projects</button>
          <h2 class="detail-title" id={`detail-title-${i}`} tabindex="-1">{work.title}</h2>
          {work.subtitle && <p class="detail-subtitle">{work.subtitle}</p>}
          <p class="detail-summary">{work.summary}</p>
          <ul class="chips">
            {work.tags.map((t) => <li class="chip">{t}</li>)}
          </ul>
          <div class="detail-links">
            {work.href ? (
              <a class="detail-link" href={work.href}>View project →</a>
            ) : (
              <span class="detail-soon">Project page coming soon</span>
            )}
            {work.github && (
              <a class="detail-link secondary" href={work.github} target="_blank" rel="noopener">GitHub ↗</a>
            )}
          </div>
        </article>
      ))}
      </div>

      <!-- The selected project's villager stands here, on a patch of ground ringed in the project's color, in a clearing of plain grass -->
      <div class="stage" id="stage" style={`--work: ${works[0].color}`}>
        <svg class="spot" viewBox="0 0 200 60" aria-hidden="true">
          <defs>
            <!-- Worn grass around the patch, fading out into the meadow (and hiding the flowers under it) -->
            <radialGradient id="worn">
              <stop offset="0.55" stop-color="#bfd38c" />
              <stop offset="1" stop-color="#bfd38c" stop-opacity="0" />
            </radialGradient>
          </defs>
          <ellipse cx="100" cy="33" rx="142" ry="42" fill="url(#worn)" />
          <ellipse class="spot-glow" cx="100" cy="30" rx="97" ry="28" />
          <ellipse cx="100" cy="30" rx="80" ry="21" fill="#cfe5b2" />
          <ellipse cx="100" cy="31" rx="62" ry="15" fill="#e9dfba" />
          <ellipse class="spot-ring" data-arrive cx="100" cy="30" rx="89" ry="25" />
        </svg>

        <!-- The villager stands on the spot. It's a button so tapping (or Enter) gives it some love. -->
        <div class="character">
          <!-- Thought cloud with a fun fact about the villager; the script fades facts in and out -->
          <div class="thought" data-thought aria-hidden="true">
            <svg class="thought-cloud" viewBox="0 0 240 124">
              <defs>
                <!-- White on top, melting into pale sky blue at the bottom like the painted clouds -->
                <linearGradient id="cloud-shade" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0.55" stop-color="#ffffff" />
                  <stop offset="1" stop-color="#eaf2f8" />
                </linearGradient>
              </defs>
              <path class="cloud-fill" d={cloud.fill} />
              {cloud.puffs.map(({ d, low }, i) => {
                const ink = puffInk(low, i);
                return <path class="cloud-ink" d={d} pathLength="100" stroke-dasharray={`0 ${ink[0]} ${ink[1]} 100`} />;
              })}
            </svg>
            <svg class="thought-puff big" viewBox="0 0 20 16"><ellipse cx="10" cy="8" rx="8.5" ry="6.5" pathLength="100" stroke-dasharray="0 12 82 100" /></svg>
            <svg class="thought-puff small" viewBox="0 0 20 16"><ellipse cx="10" cy="8" rx="8" ry="6" pathLength="100" stroke-dasharray="0 60 84 100" /></svg>
            <p class="thought-text" data-thought-text></p>
          </div>
          <button type="button" class="sprite" data-sprite hidden={!first} style={first && `background-image: url(${first.works.sheet})`}></button>
        </div>

        <!-- The villager's name, curving along the bottom of its spot (same lettering as the wooden sign) -->
        <svg class="nameplate" viewBox="0 0 300 70" aria-hidden="true" data-arrive>
          <path id="name-curve" d="M 18 14 Q 150 70 282 14" fill="none" />
          <text>
            <textPath href="#name-curve" startOffset="50%" text-anchor="middle" data-stage-name>{first?.name}</textPath>
          </text>
        </svg>

        <!-- Wooden signpost with the project number -->
        <div class="sign" data-arrive>
          <span class="board" data-stage-title aria-live="polite">{works[0].sign ?? signName(works[0].title)}</span>
          <span class="post" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="more" aria-labelledby="more-heading">
    <h2 id="more-heading">More projects</h2>
    <ul class="grid">
      {moreProjects.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li>
            <Tag class="card" href={p.href} target={p.href ? '_blank' : undefined} rel={p.href ? 'noopener' : undefined}>
              <span class="card-head">
                <img class="card-face" src={`/villagers/more/${p.face}.webp`} alt="" style={`background-color: ${p.color}`} />
                <span class="card-name">
                  {p.status && <span class="card-status">{p.status}</span>}
                  <span class="card-title">{p.title}</span>
                </span>
              </span>
              <span class="card-blurb">{p.blurb}</span>
              <span class="card-tags">
                {p.tags.map((t) => <span class="chip">{t}</span>)}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>

<script>
  import { villagers, type Step, type Villager } from '../data/villagers';

  // ---------- Villager animation ----------
  // A villager is one sprite sheet with all its frames side by side; showing frame i just means
  // sliding the sheet over by i frames. Which frames make up each animation is in src/data/villagers.ts.
  function animateVillager(sprite: HTMLElement) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let v: Villager['works'] | null = null;
    const show = (frame: number) => {
      if (v) sprite.style.backgroundPositionX = `${(frame / (v.frames - 1)) * 100}%`;
    };
    let timer = 0;
    let busy = false; // true while a hover or click animation is playing, so they don't interrupt each other

    const play = (steps: Step[], done: () => void) => {
      clearTimeout(timer);
      let i = 0;
      const next = () => {
        if (i === steps.length) return done();
        const [frame, ms] = steps[i++];
        show(frame);
        timer = window.setTimeout(next, ms);
      };
      next();
    };
    // Idle: rest, then every few seconds play the idle animation (Sammy smiles, Foxy blinks)
    const idle = () => {
      busy = false;
      if (!v) return;
      show(v.rest);
      if (reduceMotion.matches) return;
      timer = window.setTimeout(() => v && play(v.idle, idle), 2500 + Math.random() * 2500);
    };
    const react = (steps: Step[]) => {
      if (busy || reduceMotion.matches) return;
      busy = true;
      play(steps, idle);
    };

    sprite.addEventListener('pointerenter', (e) => {
      if (v && e.pointerType === 'mouse') react(v.hover); // touch screens get the click animation on tap instead
    });
    sprite.addEventListener('click', () => {
      if (!v) return;
      busy = false; // a click always plays, even mid-hover
      react(v.click);
    });

    // ---------- Fun-fact cloud ----------
    // Shows one fact at a time: fade in, hold, fade out, rest, then the next. Clicking the villager
    // skips to the next fact.
    const thought = sprite.parentElement!.querySelector<HTMLElement>('[data-thought]');
    const thoughtText = thought?.querySelector<HTMLElement>('[data-thought-text]');
    let facts: string[] = [];
    let factIndex = 0;
    let factTimer = 0;
    const SHOW_MS = 6000, REST_MS = 4000, FADE_MS = 700;
    const showFact = () => {
      if (!thought || !thoughtText || !facts.length) return;
      thoughtText.textContent = facts[factIndex % facts.length];
      factIndex++;
      thought.classList.add('is-showing');
      factTimer = window.setTimeout(() => {
        thought.classList.remove('is-showing');
        factTimer = window.setTimeout(showFact, REST_MS);
      }, SHOW_MS);
    };
    const startFacts = (list: string[] | undefined, delay: number) => {
      clearTimeout(factTimer);
      thought?.classList.remove('is-showing');
      facts = list ?? [];
      factIndex = 0;
      if (facts.length) factTimer = window.setTimeout(showFact, delay);
    };
    // Next fact on click: fade the current one out first if it's showing
    sprite.addEventListener('click', () => {
      if (!facts.length || !thought) return;
      clearTimeout(factTimer);
      const wasShowing = thought.classList.contains('is-showing');
      thought.classList.remove('is-showing');
      factTimer = window.setTimeout(showFact, wasShowing ? FADE_MS : 0);
    });

    return {
      // Switch to a different villager (or none)
      set(key: string | undefined) {
        clearTimeout(timer);
        const villager = key ? villagers[key] : undefined;
        const character = sprite.parentElement!;
        const nameplate = character.parentElement!.querySelector<SVGElement>('[data-stage-name]');
        if (nameplate) nameplate.textContent = villager?.name ?? '';
        sprite.hidden = !villager;
        startFacts(villager?.facts, 1500);
        v = villager?.works ?? null;
        if (!villager || !v) return;
        sprite.style.backgroundImage = `url(${v.sheet})`;
        sprite.setAttribute('aria-label', `Say hi to ${villager.name}`);
        character.style.setProperty('--frames', String(v.frames));
        character.style.setProperty('--fw', String(v.width));
        character.style.setProperty('--fh', String(v.height));
        idle();
      },
    };
  }

  // Clicking a project button selects it, recolors the character's spot, and updates the signpost.
  for (const root of document.querySelectorAll<HTMLElement>('[data-works]')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.work');
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const stageTitle = root.querySelector<HTMLElement>('[data-stage-title]')!;
    const animated = root.querySelectorAll<Element>('[data-arrive]');
    const details = root.querySelectorAll<HTMLElement>('[data-detail]');
    const sprite = root.querySelector<HTMLButtonElement>('[data-sprite]')!;

    // Opening a project turns the buttons into tabs on the left and shows its text box
    const column = root.querySelector<HTMLElement>('.projects-col')!;
    const open = (index: number) => {
      // Keep the scene the same height as with the full list, so the villager stays on the grass
      if (!root.classList.contains('is-open')) column.style.minHeight = `${column.offsetHeight}px`;
      root.classList.add('is-open');
      for (const d of details) d.hidden = d.dataset.detail !== String(index);
      details[index].querySelector<HTMLElement>('.detail-title')?.focus({ preventScroll: true });
    };
    const close = () => {
      root.classList.remove('is-open');
      column.style.minHeight = '';
      for (const d of details) d.hidden = true;
      root.querySelector<HTMLElement>('.work[aria-pressed="true"]')?.focus({ preventScroll: true });
    };
    for (const back of root.querySelectorAll<HTMLButtonElement>('[data-back]')) back.addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) close();
    });
    const villager = animateVillager(sprite);
    villager.set(root.querySelector<HTMLElement>('.work[aria-pressed="true"]')?.dataset.villager);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        stageTitle.textContent = button.dataset.sign ?? '';
        // Swap in this project's villager (or leave the spot empty if it doesn't have one yet)
        villager.set(button.dataset.villager);
        open(Number(button.dataset.index));
        stage.style.setProperty('--work', button.style.getPropertyValue('--work'));
        // Replay the little "arrive" animations: remove the class, force a reflow, add it back
        for (const el of animated) {
          el.classList.remove('is-arriving');
          void stage.offsetWidth;
          el.classList.add('is-arriving');
        }
      });
    }
  }

  // ---------- Living painting ----------
  // Draws the painting on a canvas with WebGL and gently bends parts of it each frame. Nothing is cut out:
  // each pixel just looks up a nearby spot of the painting, so moving things never leave holes behind.
  //   - motion.png says how far each spot sways (red) and where the lake is (green)
  //   - the sky is its own image, so the clouds can drift behind the hills
  // If WebGL isn't available or the visitor prefers less motion, the plain painting stays.
  const W = 2360; // the painting's size in pixels
  const H = 1640;
  const SKY_H = 865; // height of sky.webp
  const MAX_SWAY = 14; // pixels; matches MAX_SWAY in scripts/build-works-scene.mjs

  const vertexShader = `#version 300 es
    in vec2 corner;
    out vec2 uv;
    void main() {
      uv = vec2(corner.x * 0.5 + 0.5, 0.5 - corner.y * 0.5); // (0, 0) is the painting's top left
      gl_Position = vec4(corner, 0.0, 1.0);
    }`;
  const fragmentShader = `#version 300 es
    precision highp float;
    uniform sampler2D land, sky, motion;
    uniform float time;
    in vec2 uv;
    out vec4 color;

    // Wind. Gusts come at uneven times and strengths (the script below picks them and passes in the last
    // two: seconds since each began, and how strong). A gust's front crosses the painting left to right in
    // about 4 seconds, in step with the band of light over the meadow.
    uniform vec2 gustA, gustB;

    // Each spot gets its own rhythm, so neighbors are similar but nothing moves in lockstep
    float phase(vec2 p) {
      return sin(p.x * 23.0 + p.y * 7.0) * 2.0 + sin(p.x * 9.0 - p.y * 31.0) * 1.5;
    }

    // How a plant answers one gust: leans with the wind over half a second, then eases back upright over a
    // few seconds (no springing past upright), trembling a little while the gust is on it.
    float lean(vec2 gust, float x, float ph) {
      float since = gust.x - 1.0 - x * 3.7; // seconds since the gust's front reached this x
      if (since < 0.0) return 0.0;
      float push = smoothstep(0.0, 0.6, since) * exp(-max(since - 0.6, 0.0) * 0.75);
      float flutter = 0.12 * sin(time * 9.0 + ph * 3.0) * push;
      return gust.y * (push + flutter);
    }

    float bend(vec2 p) {
      float ph = phase(p);
      // A light, steady breeze: a slow lean downwind with an unhurried sway, different at every spot
      float calm = 0.18 + 0.14 * sin(time * 0.8 + ph) + 0.06 * sin(time * 1.9 + ph * 1.7);
      // Soft waves rolling through the grass, downwind
      float waves = 0.16 * sin(p.x * 30.0 + p.y * 18.0 - time * 1.4);
      return calm + waves + lean(gustA, p.x, ph) + lean(gustB, p.x, ph);
    }

    void main() {
      vec4 m = texture(motion, uv);
      vec2 px = vec2(${W}.0, ${H}.0);

      // Trees and flowers sway sideways; the lake wobbles in slow ripples
      float sway = m.r * ${MAX_SWAY}.0 * 0.8 * bend(uv);
      float rippleX = 1.4 * sin(uv.y * px.y * 0.12 - time * 1.7 + sin(uv.x * 9.0 + time * 0.3) * 2.0);
      float rippleY = 0.7 * sin(uv.x * px.x * 0.025 - time * 1.2 + uv.y * px.y * 0.07);
      vec2 landUv = uv - vec2(sway + m.g * rippleX, m.g * rippleY) / px;
      vec4 front = texture(land, landUv); // premultiplied: see-through where the sky is

      // Clouds drift slowly back and forth (two minutes each way). Near the left and right edges they
      // drift less, so the cut-off clouds there never slide into view.
      float edge = smoothstep(0.0, 0.08, uv.x) * smoothstep(1.0, 0.92, uv.x);
      float drift = 60.0 * sin(time * 6.2832 / 240.0) * edge;
      vec3 back = texture(sky, vec2(uv.x - drift / px.x, min(uv.y * ${H}.0 / ${SKY_H}.0, 1.0))).rgb;

      color = vec4(back * (1.0 - front.a) + front.rgb, 1.0);
    }`;

  function livePainting(scene: HTMLElement) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    const canvas = scene.querySelector<HTMLCanvasElement>('[data-live]')!;
    const gl = canvas.getContext('webgl2', { alpha: false, antialias: false });
    if (!gl) return;

    const compile = (type: number, source: string) => {
      const shader = gl.createShader(type)!;
      gl.shaderSource(shader, source);
      gl.compileShader(shader);
      return shader;
    };
    const program = gl.createProgram()!;
    gl.attachShader(program, compile(gl.VERTEX_SHADER, vertexShader));
    gl.attachShader(program, compile(gl.FRAGMENT_SHADER, fragmentShader));
    gl.linkProgram(program);
    if (!gl.getProgramParameter(program, gl.LINK_STATUS)) return;
    gl.useProgram(program);

    // One rectangle covering the canvas
    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const corner = gl.getAttribLocation(program, 'corner');
    gl.enableVertexAttribArray(corner);
    gl.vertexAttribPointer(corner, 2, gl.FLOAT, false, 0, 0);

    const load = (src: string) => {
      const img = new Image();
      img.src = src;
      return img.decode().then(() => img);
    };
    const texture = (img: HTMLImageElement, unit: number, name: string) => {
      gl.activeTexture(gl.TEXTURE0 + unit);
      gl.bindTexture(gl.TEXTURE_2D, gl.createTexture());
      gl.pixelStorei(gl.UNPACK_PREMULTIPLY_ALPHA_WEBGL, true);
      gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, img);
      gl.generateMipmap(gl.TEXTURE_2D);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.LINEAR_MIPMAP_LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.LINEAR);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
      gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
      gl.uniform1i(gl.getUniformLocation(program, name), unit);
    };
    const timeAt = gl.getUniformLocation(program, 'time');
    const gustAAt = gl.getUniformLocation(program, 'gustA');
    const gustBAt = gl.getUniformLocation(program, 'gustB');

    // Keep the canvas sharp: as many pixels as the screen shows, but no more than the painting has
    const resize = () => {
      const scale = Math.min(devicePixelRatio || 1, W / Math.max(1, scene.clientWidth));
      canvas.width = Math.round(scene.clientWidth * scale);
      canvas.height = Math.round(scene.clientHeight * scale);
      gl.viewport(0, 0, canvas.width, canvas.height);
    };

    // Gusts: the first comes 2 seconds in, then every 7-15 seconds, each a different strength. The
    // same made-up "random" numbers every visit, worked out from the gust's number.
    const random = (n: number) => {
      const v = Math.sin(n * 12.9898) * 43758.5453;
      return v - Math.floor(v);
    };
    const gusts: { start: number; strength: number }[] = [];
    const gustsUntil = (t: number) => {
      while (!gusts.length || gusts[gusts.length - 1].start < t) {
        const n = gusts.length;
        const start = n ? gusts[n - 1].start + 7 + random(n) * 8 : 2;
        gusts.push({ start, strength: 0.55 + random(n + 100) * 0.45 });
      }
      return gusts.filter((g) => g.start <= t).slice(-2);
    };

    // The band of light rides along with each gust's front (instead of its own fixed CSS loop)
    const band = scene.querySelector<HTMLElement>('[data-gust]');
    if (band) band.style.animation = 'none';

    const start = performance.now();
    const draw = () => {
      const t = (performance.now() - start) / 1000;
      const [a, b] = gustsUntil(t).reverse(); // a: the latest gust, b: the one before
      gl.uniform1f(timeAt, t);
      gl.uniform2f(gustAAt, a ? t - a.start : -99, a?.strength ?? 0);
      gl.uniform2f(gustBAt, b ? t - b.start : -99, b?.strength ?? 0);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      if (band) {
        // The front is at x = (seconds since the gust began - 1) / 3.7, as a share of the painting's width;
        // the band is 60% wide, so slide it to center on the front
        const front = a ? (t - a.start - 1) / 3.7 : 2;
        band.style.translate = `${((front - 0.3) / 0.6) * 100}% 0`;
        band.style.opacity = String(a?.strength ?? 0);
      }
    };

    // Only animate while the scene is on screen and the tab is visible
    let frame = 0;
    let visible = false;
    const loop = () => {
      draw();
      frame = requestAnimationFrame(loop);
    };
    const update = () => {
      cancelAnimationFrame(frame);
      if (visible && !document.hidden) frame = requestAnimationFrame(loop);
    };

    const { land, sky, motion } = scene.dataset;
    Promise.all([load(land!), load(sky!), load(motion!)])
      .then(([landImg, skyImg, motionImg]) => {
        texture(landImg, 0, 'land');
        texture(skyImg, 1, 'sky');
        texture(motionImg, 2, 'motion');
        resize();
        draw();
        scene.classList.add('is-live');
        new ResizeObserver(() => {
          resize();
          draw();
        }).observe(scene);
        new IntersectionObserver(([entry]) => {
          visible = entry.isIntersecting;
          update();
        }).observe(scene);
        document.addEventListener('visibilitychange', update);
      })
      .catch(() => {}); // if anything fails to load, the plain painting stays
  }

  for (const scene of document.querySelectorAll<HTMLElement>('[data-scene]')) livePainting(scene);
</script>

