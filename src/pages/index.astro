       --shown: how much of it shows; the top of the sky is cropped off so there's less empty space.
       --content-top: where the projects start. The content sits at the bottom of the painting, so the
       villager always stands in the meadow; 37.5rem is about the height of the project list. */
    --painting: calc(100vw * 1640 / 2360);
    --shown: calc(var(--painting) * 0.8);
    --land: max(17rem, 40vw);
    --content-top: max(calc(var(--land) * 0.45), calc(var(--shown) - var(--fs) * 37.5));
    position: relative;
    isolation: isolate; /* keeps the backdrop's z-index:-1 inside this section */
    /* Tall enough to show the painting, minus the top of the sky */
