        </defs>

        <rect width="1600" height="900" fill="url(#grass)" />
        <g filter="url(#wash-blur)">
          {washes.map((w) => <path d={w.d} fill={w.light ? '#d7e9bd' : '#a7c987'} opacity={w.light ? 0.7 : 0.45} />)}
