          {work.href ? (
            <a class="detail-link" href={work.href}>View project →</a>
          ) : (
            <span class="detail-soon">Project page coming soon</span>
          )}
        </article>
      ))}
      </div>

      <!-- The selected project's villager stands here, on a patch of ground ringed in the project's color -->
      <div class="stage" id="stage" style={`--work: ${works[0].color}`}>
        <svg class="spot" viewBox="0 0 200 60" aria-hidden="true">
          <ellipse class="spot-glow" cx="100" cy="30" rx="97" ry="28" />
          <ellipse cx="100" cy="30" rx="80" ry="21" fill="#cfe5b2" />
          <ellipse cx="100" cy="31" rx="62" ry="15" fill="#e9dfba" />
          <ellipse class="spot-ring" data-arrive cx="100" cy="30" rx="89" ry="25" />
        </svg>

        <!-- The villager stands on the spot. It's a button so tapping (or Enter) gives it some love. -->
        <div class="character">
          <button type="button" class="sprite" data-sprite hidden={!first} style={first && `background-image: url(${first.works.sheet})`}></button>
        </div>

        <!-- The villager's name, curving along the bottom of its spot (same lettering as the wooden sign) -->
        <svg class="nameplate" viewBox="0 0 300 70" aria-hidden="true" data-arrive>
          <path id="name-curve" d="M 18 14 Q 150 70 282 14" fill="none" />
          <text>
            <textPath href="#name-curve" startOffset="50%" text-anchor="middle" data-stage-name>{first?.name}</textPath>
          </text>
        </svg>

        <!-- Wooden signpost with the project number -->
        <div class="sign" data-arrive>
          <span class="board" data-stage-title aria-live="polite">{works[0].title.split(' – ')[0]}</span>
          <span class="post" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <section class="more" aria-labelledby="more-heading">
    <h2 id="more-heading">More projects</h2>
    <ul class="grid">
      {moreProjects.map((p) => {
        const Tag = p.href ? 'a' : 'div';
        return (
          <li>
            <Tag class="card" href={p.href} target={p.href ? '_blank' : undefined} rel={p.href ? 'noopener' : undefined}>
              <span class="card-title">{p.title}</span>
              <span class="card-blurb">{p.blurb}</span>
              <span class="card-tags">
                {p.tags.map((t) => <span class="chip">{t}</span>)}
              </span>
            </Tag>
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>

<script>
  import { villagers, type Step, type Villager } from '../data/villagers';

  // ---------- Villager animation ----------
  // A villager is one sprite sheet with all its frames side by side; showing frame i just means
  // sliding the sheet over by i frames. Which frames make up each animation is in src/data/villagers.ts.
  function animateVillager(sprite: HTMLElement) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let v: Villager['works'] | null = null;
    const show = (frame: number) => {
      if (v) sprite.style.backgroundPositionX = `${(frame / (v.frames - 1)) * 100}%`;
    };
    let timer = 0;
    let busy = false; // true while a hover or click animation is playing, so they don't interrupt each other

    const play = (steps: Step[], done: () => void) => {
      clearTimeout(timer);
      let i = 0;
      const next = () => {
        if (i === steps.length) return done();
        const [frame, ms] = steps[i++];
        show(frame);
        timer = window.setTimeout(next, ms);
      };
      next();
    };
    // Idle: rest, then every few seconds play the idle animation (Sammy smiles, Foxy blinks)
    const idle = () => {
      busy = false;
      if (!v) return;
      show(v.rest);
      if (reduceMotion.matches) return;
      timer = window.setTimeout(() => v && play(v.idle, idle), 2500 + Math.random() * 2500);
    };
    const react = (steps: Step[]) => {
      if (busy || reduceMotion.matches) return;
      busy = true;
      play(steps, idle);
    };

    sprite.addEventListener('pointerenter', (e) => {
      if (v && e.pointerType === 'mouse') react(v.hover); // touch screens get the click animation on tap instead
    });
    sprite.addEventListener('click', () => {
      if (!v) return;
      busy = false; // a click always plays, even mid-hover
      react(v.click);
    });

    return {
      // Switch to a different villager (or none)
      set(key: string | undefined) {
        clearTimeout(timer);
        const villager = key ? villagers[key] : undefined;
        const character = sprite.parentElement!;
        const nameplate = character.parentElement!.querySelector<SVGElement>('[data-stage-name]');
        if (nameplate) nameplate.textContent = villager?.name ?? '';
        sprite.hidden = !villager;
        v = villager?.works ?? null;
        if (!villager || !v) return;
        sprite.style.backgroundImage = `url(${v.sheet})`;
        sprite.setAttribute('aria-label', `Say hi to ${villager.name}`);
        character.style.setProperty('--frames', String(v.frames));
        character.style.setProperty('--fw', String(v.width));
        character.style.setProperty('--fh', String(v.height));
        idle();
      },
    };
  }

  // Clicking a project button selects it, recolors the character's spot, and updates the signpost.
  for (const root of document.querySelectorAll<HTMLElement>('[data-works]')) {
    const buttons = root.querySelectorAll<HTMLButtonElement>('.work');
    const stage = root.querySelector<HTMLElement>('.stage')!;
    const stageTitle = root.querySelector<HTMLElement>('[data-stage-title]')!;
    const animated = root.querySelectorAll<Element>('[data-arrive]');
    const details = root.querySelectorAll<HTMLElement>('[data-detail]');
    const sprite = root.querySelector<HTMLButtonElement>('[data-sprite]')!;

    // Opening a project turns the buttons into tabs on the left and shows its text box
    const column = root.querySelector<HTMLElement>('.projects-col')!;
    const open = (index: number) => {
      // Keep the scene the same height as with the full list, so the villager stays on the grass
      if (!root.classList.contains('is-open')) column.style.minHeight = `${column.offsetHeight}px`;
      root.classList.add('is-open');
      for (const d of details) d.hidden = d.dataset.detail !== String(index);
      details[index].querySelector<HTMLElement>('.detail-title')?.focus({ preventScroll: true });
    };
    const close = () => {
      root.classList.remove('is-open');
      column.style.minHeight = '';
      for (const d of details) d.hidden = true;
      root.querySelector<HTMLElement>('.work[aria-pressed="true"]')?.focus({ preventScroll: true });
    };
    for (const back of root.querySelectorAll<HTMLButtonElement>('[data-back]')) back.addEventListener('click', close);
    root.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('is-open')) close();
    });
    const villager = animateVillager(sprite);
    villager.set(root.querySelector<HTMLElement>('.work[aria-pressed="true"]')?.dataset.villager);

    for (const button of buttons) {
      button.addEventListener('click', () => {
        for (const b of buttons) b.setAttribute('aria-pressed', String(b === button));
        stageTitle.textContent = button.dataset.sign ?? '';
        // Swap in this project's villager (or leave the spot empty if it doesn't have one yet)
        villager.set(button.dataset.villager);
        open(Number(button.dataset.index));
        stage.style.setProperty('--work', button.style.getPropertyValue('--work'));
        // Replay the little "arrive" animations: remove the class, force a reflow, add it back
        for (const el of animated) {
          el.classList.remove('is-arriving');
          void stage.offsetWidth;
          el.classList.add('is-arriving');
        }
      });
    }
  }
</script>

<style>
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3rem);
  }
  .intro {
    margin: 0.25rem 0 1.5rem;
    color: var(--muted);
  }

  /* ---------- Full-width scene ---------- */
  .field {
    /* Height of the sky/mountains/lake part. Matches the drawing's shape (640 / 1600 = 40% of the width)
       so the clouds are never cut off; on narrow screens the 17rem minimum crops the sides instead. */
    --land: max(17rem, 40vw);
    position: relative;
    isolation: isolate; /* keeps the backdrop's z-index:-1 inside this section */
    /* Break out of the page's centered column to span the whole window */
    width: 100vw;
    margin-inline: calc(50% - 50vw);
  }

  .backdrop {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: #b6d693;
  }
  /* Fade the page background into the top of the sky so there's no hard edge */
  .backdrop::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2.5rem;
    z-index: 1;
    background: linear-gradient(var(--bg), transparent);
  }
  /* ...and fade the bottom of the meadow back into the page, above the "More projects" grid */
  .backdrop::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 3.5rem;
    z-index: 1;
    background: linear-gradient(transparent, var(--bg));
  }

  .landscape {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: var(--land);
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  /* Thin navy ink outlines with little gaps, like a pen lifting off the paper */
  .ink path {
    stroke: #56739f;
    stroke-width: 1.4;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 140 7 46 5 210 9 80 4 120 8;
  }
  .ink .shade {
    fill: none;
    stroke: #a9bdd6;
    stroke-width: 1.3;
    stroke-dasharray: 36 9 20 7;
  }
  /* Storybook trees: each tree's greens come from --c (canopy) and --h (highlight).
     The outline has small gaps like the clouds. */
  .trees .canopy {
    fill: var(--c);
    stroke: #4f6b5c;
    stroke-width: 1.3;
    stroke-linejoin: round;
    stroke-linecap: round;
    stroke-dasharray: 34 3 18 4 52 2;
  }
  .trees .highlight {
    fill: var(--h);
    stroke: none;
  }
  /* Same color as the canopy, so only a crescent of the highlight shows */
  .trees .cover {
    fill: var(--c);
    stroke: none;
  }
  .trees .curls {
    fill: none;
    stroke: #6b9160;
    stroke-width: 1.2;
    stroke-linecap: round;
  }
  .trees .trunk {
    fill: #8b7361;
    stroke: #4f6b5c;
    stroke-width: 1.2;
  }
  /* Back-row trees are a little paler, as if further away */
  .trees .far .canopy,
  .trees .far .cover {
    fill: color-mix(in srgb, var(--c) 72%, #e6f0dc);
  }
  .trees .far .highlight {
    fill: color-mix(in srgb, var(--h) 72%, #eef5e6);
  }
  .trees .far .curls {
    stroke: #86a979;
  }
  /* The big waterside trees are softer and more muted */
  .trees.near .canopy,
  .trees.near .cover {
    fill: color-mix(in srgb, var(--c) 82%, #8a9f86);
  }
  .trees.near .canopy {
    stroke: #5f7d68;
    stroke-width: 1.1;
  }
  .trees.near .highlight {
    fill: color-mix(in srgb, var(--h) 82%, #a3b39f);
  }

  /* Breeze: every 11 seconds a gust sweeps left to right. Each tree's --delay is set from its position,
     so it bends right when the gust reaches it, springs back, then idles with a tiny sway. */
  .breeze {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: breeze 11s ease-in-out var(--delay) infinite;
  }
  @keyframes breeze {
    0% {
      rotate: 0deg;
    }
    7% {
      rotate: 3deg;
    }
    15% {
      rotate: -1deg;
    }
    23% {
      rotate: 0.8deg;
    }
    32% {
      rotate: -0.3deg;
    }
    55% {
      rotate: 0.4deg;
    }
    78% {
      rotate: -0.3deg;
    }
    100% {
      rotate: 0deg;
    }
  }

  /* Clouds drift slowly to the right. Each layer holds its cloud plus a twin one scene-width to the left;
     the layer slides exactly one width, so when it starts over the twin is where the original began. */
  .cloud {
    animation: drift-right var(--d) linear infinite;
  }
  @keyframes drift-right {
    from {
      translate: 0 0;
    }
    to {
      translate: 100% 0;
    }
  }

  /* Hand-drawn outline along the top edge of the near grass, with gaps like the other ink lines */
  .bank-line {
    fill: none;
    stroke: #5f7d68;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 90 6 34 4 140 8 60 5;
  }

  /* Light glinting on the lake */
  .shimmer line {
    stroke: #f7fafd;
    stroke-width: 2.4;
    stroke-linecap: round;
    animation: glint 3.6s ease-in-out var(--delay) infinite;
  }
  @keyframes glint {
    0%,
    100% {
      opacity: 0.2;
      translate: 0 0;
    }
    50% {
      opacity: 0.9;
      translate: 6px 0;
    }
  }

  .bird {
    position: absolute;
    top: calc(var(--land) * var(--top) / 100);
    left: -3rem;
    width: calc(1.4rem * var(--s));
    fill: none;
    stroke: #56739f;
    stroke-width: 1.6;
    stroke-linecap: round;
    animation:
      fly var(--d) linear var(--delay) infinite,
      flap 0.9s ease-in-out infinite alternate;
  }
  @keyframes fly {
    to {
      left: 100%;
      translate: 0 -1.5rem;
    }
  }
  @keyframes flap {
    to {
      scale: 1 0.55;
    }
  }
  /* Birds that stay in view, looping around a spot */
  .bird.wander {
    left: var(--left);
    animation:
      wander var(--d) ease-in-out var(--delay) infinite alternate,
      flap 0.9s ease-in-out infinite alternate;
  }
  @keyframes wander {
    0% {
      translate: 0 0;
    }
    25% {
      translate: 2.2rem -0.8rem;
    }
    50% {
      translate: -1rem -1.4rem;
    }
    75% {
      translate: 2.6rem 0.4rem;
    }
    100% {
      translate: -1.8rem 0.3rem;
    }
  }

  /* The meadow covers everything below the lake; "slice" crops the drawing instead of stretching it */
  .meadow {
    position: absolute;
    top: calc(var(--land) - 1px);
    left: 0;
    width: 100%;
    height: calc(100% - var(--land) + 1px);
  }
  /* Gust: a wide, very soft band of light that sweeps across the meadow and then waits */
  .gust {
    position: absolute;
    top: calc(var(--land) * 0.62);
    bottom: 0;
    left: 0;
    width: 60%;
    background: linear-gradient(100deg, transparent, rgb(255 255 240 / 0.16) 45%, rgb(255 255 240 / 0.16) 55%, transparent);
    mask-image: linear-gradient(transparent, #000 35%);
    translate: -100% 0;
    animation: gust 11s ease-in-out infinite;
  }
  @keyframes gust {
    0% {
      translate: -100% 0;
    }
    55%,
    100% {
      translate: 180% 0;
    }
  }
  .pebble {
    fill: #f1f3e8;
    opacity: 0.85;
  }

  .stem {
    fill: none;
    stroke: #6f9e5c;
    stroke-width: 1.4;
    stroke-linecap: round;
  }
  .leaf {
    fill: #9cc77e;
    stroke: #5f8f62;
    stroke-width: 0.8;
  }
  .petal {
    fill: #fffdf7;
    stroke: #8e9fb8;
    stroke-width: 0.6;
  }
  .bloom {
    fill: #f3a98f;
    stroke: #b97866;
    stroke-width: 1;
  }

  .front {
    position: absolute;
    bottom: 0;
    width: clamp(6rem, 12vw, 10rem);
  }
  .front.left {
    left: 0;
  }
  .front.right {
    right: 0;
  }

  /* Flowers ruffle when the gust passes (same 11s cycle as the trees), with a little idle sway between */
  .ruffle {
    transform-box: fill-box;
    transform-origin: 50% 100%;
    animation: ruffle 11s ease-in-out var(--delay) infinite;
  }
  @keyframes ruffle {
    0% {
      rotate: 0deg;
    }
    6% {
      rotate: 10deg;
    }
    12% {
      rotate: -5deg;
    }
    19% {
      rotate: 4deg;
    }
    27% {
      rotate: -1.5deg;
    }
    50% {
      rotate: 2deg;
    }
    75% {
      rotate: -1.5deg;
    }
    100% {
      rotate: 0deg;
    }
  }
