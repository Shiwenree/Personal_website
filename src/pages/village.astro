---
import BaseLayout from '../layouts/BaseLayout.astro';
import { villagers } from '../data/villagers';

// A first test of villagers walking around, before the real Phaser village exists.
// Just a patch of meadow where the villagers wander: side to side, up and down, and diagonally.

// Scatter some daisies with a seeded random generator, so they land in the same places every build
function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = seeded(7);
const daisies = Array.from({ length: 26 }, () => ({
  x: (rand() * 100).toFixed(1),
  y: (rand() * 100).toFixed(1),
  r: (2.5 + rand() * 2).toFixed(1),
  pink: rand() < 0.3,
}));
---

<BaseLayout title="Village">
  <h1>Village</h1>
  <p class="intro">The village is still being built. A few villagers are out for a walk in the meantime. Click the meadow to call one over.</p>

  <div class="meadow" data-meadow>
    <svg class="flowers" aria-hidden="true">
      {daisies.map((d) => (
        <g>
          <circle cx={`${d.x}%`} cy={`${d.y}%`} r={d.r} fill={d.pink ? '#f3b8c8' : '#fffdf5'} />
          <circle cx={`${d.x}%`} cy={`${d.y}%`} r={(+d.r * 0.4).toFixed(1)} fill="#f2c94c" />
        </g>
      ))}
    </svg>

    {Object.entries(villagers).map(([key, { name, village: v }]) => (
      <div
        class="walker"
        data-walker={key}
        role="img"
        aria-label={`${name} walking around`}
        style={`--fw: ${v.width}; --fh: ${v.height}; --frames: ${v.frames}`}
      >
        <span class="shadow"></span>
        <span class="sprite" style={`background-image: url(${v.sheet})`}></span>
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  import { villagers } from '../data/villagers';

  // Each villager wanders on its own: side to side, up and down, and diagonally, resting in between.
  // Which sprite frames make up the walk and idle animations is in src/data/villagers.ts.
  const SPEED = 70; // default walking speed, px per second (a villager can set its own)
  const STEP_MS = 170; // default time per walk frame

  for (const meadow of document.querySelectorAll<HTMLElement>('[data-meadow]')) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

    const walkerEls = [...meadow.querySelectorAll<HTMLElement>('[data-walker]')];
    const walkers = walkerEls.map((el, index) => {
      const v = villagers[el.dataset.walker!].village;
      const sprite = el.querySelector<HTMLElement>('.sprite')!;
      const show = (frame: number) => {
        sprite.style.backgroundPositionX = `${(frame / (v.frames - 1)) * 100}%`;
      };

      // Position is in px from the meadow's top-left; it's where the villager's feet touch the ground
      let minX = 0, maxX = 0, minY = 0, maxY = 0;
      const measure = () => {
        const size = el.offsetWidth;
        minX = size / 2;
        maxX = meadow.clientWidth - size / 2;
        minY = el.offsetHeight * 0.85;
        maxY = meadow.clientHeight - 12;
      };
      measure();
      const clampX = (n: number) => Math.min(maxX, Math.max(minX, n));
      const clampY = (n: number) => Math.min(maxY, Math.max(minY, n));
      // Start spread out across the meadow, alternating near and far
      let x = clampX(minX + (maxX - minX) * ((index + 0.5) / walkerEls.length));
      let y = clampY(minY + (maxY - minY) * (index % 2 ? 0.3 : 0.75));
      let target: { x: number; y: number } | null = null;
      let facing = index % 2 ? v.left : v.right;
      let restUntil = performance.now() + 800 + index * 1500;
      let idleTimer = 0;
      let walkTime = 0;

      const place = () => {
        // A little smaller further back, and further back walks behind closer things
        const depth = (y - minY) / Math.max(maxY - minY, 1);
        el.style.translate = `${x}px ${y}px`;
        el.style.scale = String(0.85 + depth * 0.15);
        el.style.zIndex = String(Math.round(y));
      };

      // Pick somewhere to wander: mix of straight across, straight up/down, and diagonal trips
      const wander = () => {
        const w = maxX - minX, h = maxY - minY;
        const kind = Math.random();
        const dist = 0.25 + Math.random() * 0.45;
        const sx = Math.random() < 0.5 ? -1 : 1, sy = Math.random() < 0.5 ? -1 : 1;
        let tx = x, ty = y;
        if (kind < 0.35) tx = x + sx * dist * w; // side to side
        else if (kind < 0.6) ty = y + sy * dist * h * 1.5; // up or down
        else { tx = x + sx * dist * w * 0.7; ty = y + sy * dist * h; } // diagonal
        // If that would walk into the edge, go the other way instead
        if (tx !== clampX(tx)) tx = x - (tx - x);
        if (ty !== clampY(ty)) ty = y - (ty - y);
        target = { x: clampX(tx), y: clampY(ty) };
      };

      const rest = (now: number) => {
        target = null;
        // Most villagers rest facing front; ones drawn resting sideways keep facing the way they walked
        if (v.restRight !== undefined && facing === v.right) {
          show(v.restRight);
          restUntil = now + 1200 + Math.random() * 2800;
          return;
        }
        show(v.rest);
        restUntil = now + 1200 + Math.random() * 2800;
        // Sometimes play the idle animation while resting
        if (Math.random() < 0.6) {
          let i = 0;
          const next = () => {
            if (target || i === v.idle.length) return;
            const [frame, ms] = v.idle[i++];
            show(frame);
            idleTimer = window.setTimeout(next, ms);
          };
          idleTimer = window.setTimeout(next, 400);
        }
      };

      show(v.rest);
      place();
      return {
        distanceTo: (px: number, py: number) => Math.hypot(px - x, py - y),
        goTo(px: number, py: number) {
          clearTimeout(idleTimer);
          target = { x: clampX(px), y: clampY(py) };
        },
        resize() {
          measure();
          x = clampX(x);
          y = clampY(y);
          place();
        },
        tick(now: number, dt: number) {
          if (!target && now >= restUntil) wander();
          if (target) {
            const dx = target.x - x, dy = target.y - y;
            const dist = Math.hypot(dx, dy);
            if (dist < 2) {
              rest(now);
            } else {
              const move = Math.min(dist, (v.speed ?? SPEED) * dt);
              x += (dx / dist) * move;
              y += (dy / dist) * move;
              // Face the way they're heading. Going straight up or down keeps whichever side they
              // last faced and walks the same way, just moving up or down the screen.
              if (Math.abs(dx) > 4) facing = dx < 0 ? v.left : v.right;
              walkTime += dt * 1000;
              show(facing[Math.floor(walkTime / (v.stepMs ?? STEP_MS)) % facing.length]);
            }
          }
          place();
        },
      };
    });

    // Click (or tap) the meadow and the closest villager walks to that spot
    meadow.addEventListener('click', (e) => {
      if (reduceMotion.matches) return;
      const box = meadow.getBoundingClientRect();
      const px = e.clientX - box.left, py = e.clientY - box.top;
      const closest = walkers.reduce((a, b) => (b.distanceTo(px, py) < a.distanceTo(px, py) ? b : a));
      closest.goTo(px, py);
    });

    new ResizeObserver(() => walkers.forEach((w) => w.resize())).observe(meadow);

    if (!reduceMotion.matches) {
      let last = performance.now();
      const frame = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        for (const w of walkers) w.tick(now, dt);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  h1 {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3rem);
  }
  .intro {
    margin: 0.25rem 0 1.5rem;
    color: var(--muted);
  }

  .meadow {
    position: relative;
    height: clamp(22rem, 55vh, 32rem);
    overflow: hidden;
    border-radius: var(--radius);
    background:
      radial-gradient(ellipse 40% 30% at 25% 35%, rgb(215 233 189 / 0.7), transparent),
      radial-gradient(ellipse 35% 25% at 75% 70%, rgb(167 201 135 / 0.45), transparent),
      linear-gradient(#c9e2a6, #aecf8c);
    box-shadow: var(--shadow);
    cursor: pointer;
  }
  .flowers {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* The walker's top-left corner sits at the villager's feet; the sprite hangs up and to the left from there */
  .walker {
    position: absolute;
    top: 0;
    left: 0;
    /* Sized to one frame of the sheet, scaled by frame width so every villager is drawn at the same scale */
    width: calc(clamp(6.5rem, 14vw, 9rem) * var(--fw) / 450);
    aspect-ratio: var(--fw) / var(--fh);
    transform-origin: 0 0;
    pointer-events: none;
  }
  .sprite,
  .shadow {
    position: absolute;
    left: -50%;
    bottom: 100%;
    width: 100%;
    height: 100%;
    margin-bottom: -2%;
  }
  .sprite {
    background: no-repeat 0 0 / calc(var(--frames) * 100%) 100%;
  }
  .shadow {
    left: -32%;
    width: 64%;
    height: 14%;
    margin-bottom: -7%;
    border-radius: 50%;
    background: rgb(60 90 40 / 0.18);
  }
</style>
