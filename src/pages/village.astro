---
import BaseLayout from '../layouts/BaseLayout.astro';
import VillageScene from '../components/VillageScene.astro';
import { villagers } from '../data/villagers';
import { MAP, BUILDINGS, placed } from '../data/village-map';
import { cloud, puffInk } from '../data/thought-cloud';
import '@fontsource/baloo-2/800.css'; // the thought cloud's lettering, same as on the Works page
import { statSync } from 'node:fs';

// Sprite sheets get "?v=<when the file last changed>" so browsers fetch redrawn ones instead of old saved copies
const versioned = (file: string) => `${file}?v=${Math.round(statSync(`public${file}`).mtimeMs)}`;

// A first version of the village, before the real Phaser game exists: a drawn map (forest around a
// clearing with the hand-drawn buildings in it) where the villagers wander and can be called over.
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---

<BaseLayout title="Village">
  <h1>Village</h1>
  <p class="intro">The village is still being built. Wander around, click anywhere in the clearing to call a villager over, tap a villager to say hi, or pick one up and carry them somewhere new. Hover over a building to learn about it.</p>

  <!-- On narrow screens the map keeps its size and scrolls sideways instead of shrinking to nothing -->
  <!-- The thought clouds' shading: white on top, melting into pale sky blue at the bottom -->
  <svg width="0" height="0" aria-hidden="true" style="position: absolute">
    <linearGradient id="cloud-shade" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0.55" stop-color="#ffffff" />
      <stop offset="1" stop-color="#eaf2f8" />
    </linearGradient>
  </svg>

  <div class="scroller">
    <div class="map" data-map style={`aspect-ratio: ${MAP.width} / ${MAP.height}`}>
      <VillageScene layer="back" />
      <VillageScene layer="trees" />

      <!-- Each building is stacked by where it meets the ground, the same way the villagers are, so
           villagers walk behind the ones further down the map and in front of the ones further up -->
      {BUILDINGS.map((b, i) => {
        const { left, top, w, h, ground, at } = placed(b);
        const z = b.flat ? 1 : Math.round(ground);
        const sails = b.sails && { size: b.sails.size * b.scale, hub: at(b.sails.hub) };
        return (
          <>
            <img
              class="building"
              data-building={i}
              src={versioned(b.src)}
              alt={b.name}
              decoding="async"
              style={`left: ${pct(left, MAP.width)}; top: ${pct(top, MAP.height)}; width: ${pct(w, MAP.width)}; height: ${pct(h, MAP.height)}; z-index: ${z}`}
            />
            {sails && (
              <img
                class="sails"
                src={versioned(b.sails!.src)}
                alt=""
                decoding="async"
                style={`left: ${pct(sails.hub[0] - sails.size / 2, MAP.width)}; top: ${pct(sails.hub[1] - sails.size / 2, MAP.height)}; width: ${pct(sails.size, MAP.width)}; height: ${pct(sails.size, MAP.height)}; z-index: ${z}`}
              />
            )}
          </>
        );
      })}

      <!-- The card that pops up over a building you're hovering over (or tapped) -->
      <div class="building-card" data-card role="status">
        <p class="building-name" data-card-name></p>
        <p class="building-about" data-card-about></p>
      </div>

      {Object.entries(villagers).map(([key, { name, village: v }]) => (
        <div
          class="walker"
          data-walker={key}
          role="img"
          aria-label={`${name} walking around`}
          style={`--fw: ${v.width}; --fh: ${v.height}; --frames: ${v.frames}`}
        >
          <span class="shadow"></span>
          <span class="sprite" data-sprite style={`background-image: url(${versioned(v.sheet)})`}></span>
          <!-- Thought cloud, shown for a few seconds when the villager is tapped -->
          <div class="thought" data-thought aria-hidden="true">
            <svg class="thought-cloud" viewBox="0 0 240 124">
              <path class="cloud-fill" d={cloud.fill} />
              {cloud.puffs.map(({ d, low }, i) => {
                const ink = puffInk(low, i);
                return <path class="cloud-ink" d={d} pathLength="100" stroke-dasharray={`0 ${ink[0]} ${ink[1]} 100`} />;
              })}
            </svg>
            <svg class="thought-puff big" viewBox="0 0 20 16"><ellipse cx="10" cy="8" rx="8.5" ry="6.5" pathLength="100" stroke-dasharray="0 12 82 100" /></svg>
            <svg class="thought-puff small" viewBox="0 0 20 16"><ellipse cx="10" cy="8" rx="8" ry="6" pathLength="100" stroke-dasharray="0 60 84 100" /></svg>
            <p class="thought-text" data-thought-text></p>
          </div>
        </div>
      ))}

      <VillageScene layer="front" />
    </div>
  </div>
</BaseLayout>

<script>
  import { villagers } from '../data/villagers';
  import { MAP, WALKABLE, OBSTACLES, HUB, BUILDINGS, placed } from '../data/village-map';

  // Each villager wanders the clearing on its own: side to side, up and down, and diagonally, resting
  // in between, and never walking through the buildings or the garden.
  // Positions are in map units (the map is 1600 x 1000), converted to pixels when drawn.
  // Which sprite frames make up the walk and idle animations is in src/data/villagers.ts.
  const SPEED = 70; // default walking speed, map units per second (a villager can set its own)
  const STEP_MS = 170; // default time per walk frame
  const MARGIN = 26; // how close a villager's feet may get to an obstacle
  const GREET_MS = 3200; // how long the thought cloud stays up after tapping a villager
  const LIFT = 30; // how high a picked-up villager is held above the ground, in map units
  const FALL_S = 0.32; // how long a dropped villager takes to land
  const CARD_MS = 4000; // on touch screens, how long a building's card stays up after tapping it

  // What a villager thinks when you tap it (one at random, never the same twice in a row)
  const greetings = (name: string) => [
    'Hi there!',
    'Oh! Hello!',
    `Hi, I'm ${name}!`,
    'Welcome to the village!',
    'Hello, friend!',
    'Lovely day for a walk.',
    'Have you tried the bakery?',
    'Nice to see you!',
  ];
  // ...and what it thinks after being carried somewhere and put down
  const landings = ['Whee!', 'Whoa, I can fly!', 'Where am I now?', 'Again! Again!', 'That was fun!'];
  // ...or after being let go over the woods (it pops back into the clearing instead)
  const lostLines = ['Not the woods!', 'Too many trees out there!', 'Back to the village!', 'Phew, made it back!'];

  type Point = { x: number; y: number };

  const canStand = (x: number, y: number) => {
    const dx = (x - WALKABLE.cx) / WALKABLE.rx;
    const dy = (y - WALKABLE.cy) / WALKABLE.ry;
    if (dx * dx + dy * dy > 1) return false;
    return !OBSTACLES.some(([l, t, r, b]) => x > l - MARGIN && x < r + MARGIN && y > t && y < b + MARGIN * 0.6);
  };
  // Is the straight line between two points walkable all the way?
  const clearPath = (a: Point, b: Point) => {
    const steps = Math.ceil(Math.hypot(b.x - a.x, b.y - a.y) / 10);
    for (let i = 1; i <= steps; i++) {
      const t = i / steps;
      if (!canStand(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t)) return false;
    }
    return true;
  };
  // A route from a to b: straight if possible, otherwise via the middle of the clearing. Null if neither works.
  const route = (a: Point, b: Point): Point[] | null => {
    if (!canStand(b.x, b.y)) return null;
    if (clearPath(a, b)) return [b];
    if (clearPath(a, HUB) && clearPath(HUB, b)) return [HUB, b];
    return null;
  };
  // The closest spot to p a villager can stand on (for putting one down in a building or the woods)
  const nearestSpot = (p: Point): Point => {
    if (canStand(p.x, p.y)) return p;
    for (let r = 8; r < 1200; r += 8)
      for (let k = 0; k < 36; k++) {
        const a = (k / 36) * Math.PI * 2;
        const q = { x: p.x + Math.cos(a) * r, y: p.y + Math.sin(a) * r * 0.7 };
        if (canStand(q.x, q.y)) return q;
      }
    return HUB;
  };
  const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), hi);
  // Where a villager put down at p lands: dropped on a building, it falls to the ground just in front
  // of it; let go over the woods, it pops straight back to the nearest spot in the clearing
  const landingSpot = (p: Point): Point => {
    const under = OBSTACLES.find(([l, t, r, b]) => p.x > l - MARGIN && p.x < r + MARGIN && p.y > t && p.y < b + MARGIN * 0.6);
    if (!under) return nearestSpot(p);
    const [l, , r, b] = under;
    return nearestSpot({ x: clamp(p.x, l, r), y: b + MARGIN * 0.6 + 8 });
  };
  const randomSpot = (): Point => {
    for (let i = 0; i < 200; i++) {
      const p = { x: WALKABLE.cx + (Math.random() * 2 - 1) * WALKABLE.rx, y: WALKABLE.cy + (Math.random() * 2 - 1) * WALKABLE.ry };
      if (canStand(p.x, p.y)) return p;
    }
    return HUB;
  };

  for (const map of document.querySelectorAll<HTMLElement>('[data-map]')) {
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    // On phones the map is wider than the screen; start scrolled to the middle
    const scroller = map.parentElement!;
    scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
    let scale = map.clientWidth / MAP.width; // pixels per map unit

    const walkers = [...map.querySelectorAll<HTMLElement>('[data-walker]')].map((el, index) => {
      const { name, village: v } = villagers[el.dataset.walker!];
      const sprite = el.querySelector<HTMLElement>('.sprite')!;
      const thought = el.querySelector<HTMLElement>('[data-thought]')!;
      const thoughtText = thought.querySelector<HTMLElement>('[data-thought-text]')!;
      const lines = greetings(name);
      let lastLine = -1;
      let greeting = false;
      let greetTimer = 0;
      const show = (frame: number) => {
        sprite.style.backgroundPositionX = `${(frame / (v.frames - 1)) * 100}%`;
      };

      let { x, y } = randomSpot();
      let path: Point[] = []; // where it's walking to (the last point is the destination)
      let facing = index % 2 ? v.left : v.right;
      let restUntil = performance.now() + 800 + index * 1200;
      let idleTimer = 0;
      let walkTime = 0;
      // Being carried: where it was grabbed (relative to its feet), how high it's held, how far it's
      // swinging, and where it was a frame ago (to swing it by how fast it's moving)
      let held = false;
      let grab: Point = { x: 0, y: 0 };
      let lift = 0;
      let swing = 0;
      let lastX = x;
      let fall: { from: Point; to: Point; t: number } | null = null;
      let lost = false; // let go over the woods and popped back into the clearing

      const place = () => {
        // A touch smaller further back, and further back walks behind closer things
        const depth = clamp((y - (WALKABLE.cy - WALKABLE.ry)) / (WALKABLE.ry * 2), 0, 1);
        el.style.translate = `${x * scale}px ${y * scale}px`;
        el.style.scale = String(0.9 + depth * 0.1);
        // Held up off the ground; its shadow stays down where its feet would land
        sprite.style.translate = lift ? `0 ${-lift * scale}px` : '';
        // While carried it's held over everything; while thinking, its cloud goes over everything, even
        // the trees along the bottom
        el.style.zIndex = held || fall ? '7000' : greeting ? '6000' : String(Math.round(y));
      };

      // Think something for a few seconds
      const think = (line: string) => {
        thoughtText.textContent = line;
        greeting = true;
        thought.classList.add('is-showing');
        place();
        clearTimeout(greetTimer);
        greetTimer = window.setTimeout(() => {
          thought.classList.remove('is-showing');
          // Let the fade finish before it drops back into the crowd
          greetTimer = window.setTimeout(() => {
            greeting = false;
            place();
          }, 700);
        }, GREET_MS);
      };

      // Back on the ground after being carried: a little squash, then it says how that was
      const land = (now: number) => {
        fall = null;
        lift = 0;
        swing = 0;
        sprite.style.rotate = '';
        el.classList.remove('is-held');
        el.classList.add('is-landing');
        sprite.addEventListener('animationend', () => el.classList.remove('is-landing'), { once: true });
        show(v.rest);
        restUntil = now + GREET_MS + 600;
        const said = lost ? lostLines : landings;
        lost = false;
        think(said[Math.floor(Math.random() * said.length)]);
      };

      // Pick somewhere to wander: a mix of straight across, straight up/down, and diagonal trips
      const wander = () => {
        for (let attempt = 0; attempt < 25; attempt++) {
          const kind = Math.random();
          const dist = 120 + Math.random() * 280;
          const sx = Math.random() < 0.5 ? -1 : 1, sy = Math.random() < 0.5 ? -1 : 1;
          let tx = x, ty = y;
          if (kind < 0.35) tx = x + sx * dist; // side to side
          else if (kind < 0.6) ty = y + sy * dist * 0.6; // up or down
          else { tx = x + sx * dist * 0.75; ty = y + sy * dist * 0.5; } // diagonal
          if (canStand(tx, ty) && clearPath({ x, y }, { x: tx, y: ty })) {
            path = [{ x: tx, y: ty }];
            return;
          }
        }
        restUntil = performance.now() + 1500; // nowhere good right now; try again shortly
      };

      const rest = (now: number) => {
        path = [];
        sprite.style.rotate = '';
        // Most villagers rest facing front; ones drawn resting sideways keep facing the way they walked
        if (v.restRight !== undefined && facing === v.right) {
          show(v.restRight);
          restUntil = now + 1200 + Math.random() * 2800;
          return;
        }
        show(v.rest);
        restUntil = now + 1500 + Math.random() * 3500;
        // Sometimes play the idle animation while resting
        if (Math.random() < 0.6) {
          let i = 0;
          const next = () => {
            if (path.length || i === v.idle.length) return;
            const [frame, ms] = v.idle[i++];
            show(frame);
            idleTimer = window.setTimeout(next, ms);
          };
          idleTimer = window.setTimeout(next, 400);
        }
      };

      show(v.rest);
      place();
      return {
        sprite,
        distanceTo: (p: Point) => Math.hypot(p.x - x, p.y - y),
        // Is this screen point on the villager? Returns how far down the map it stands (so the one in
        // front wins when two overlap), or -1 if not.
        hit(cx: number, cy: number) {
          const r = sprite.getBoundingClientRect();
          return cx >= r.left && cx <= r.right && cy >= r.top && cy <= r.bottom ? y : -1;
        },
        // Tapped: stop, face you, and think a greeting for a few seconds
        greet() {
          path = [];
          clearTimeout(idleTimer);
          sprite.style.rotate = '';
          show(v.rest);
          restUntil = performance.now() + GREET_MS + 600;
          let i = Math.floor(Math.random() * lines.length);
          if (i === lastLine) i = (i + 1) % lines.length;
          lastLine = i;
          think(lines[i]);
        },
        // Picked up at map point p. Its feet drop down below where it's held, so it stays under the
        // pointer and its shadow shows where it would land.
        pickUp(p: Point) {
          path = [];
          fall = null;
          clearTimeout(idleTimer);
          clearTimeout(greetTimer);
          thought.classList.remove('is-showing');
          greeting = false;
          held = true;
          grab = { x: x - p.x, y: y - p.y + LIFT };
          lift = LIFT;
          lastX = x;
          el.classList.add('is-held');
          this.carry(p);
        },
        carry(p: Point) {
          x = clamp(p.x + grab.x, 0, MAP.width);
          y = clamp(p.y + grab.y, LIFT, MAP.height);
          place();
        },
        // Let go: it drops to the ground (in front of the building if it's over one). Over the woods it
        // pops back into the clearing first and drops there.
        drop() {
          held = false;
          const to = landingSpot({ x, y });
          if (!canStand(x, y) && !OBSTACLES.some(([l, t, r, b]) => x > l - MARGIN && x < r + MARGIN && y > t && y < b + MARGIN * 0.6)) {
            lost = true;
            ({ x, y } = to);
          }
          if (reduceMotion.matches) {
            ({ x, y } = to);
            land(performance.now());
          } else fall = { from: { x, y }, to, t: 0 };
          place();
        },
        goTo(p: Point) {
          const r = route({ x, y }, p);
          if (!r) return false;
          clearTimeout(idleTimer);
          path = r;
          return true;
        },
        resize() {
          place();
        },
        tick(now: number, dt: number) {
          if (held) {
            // Dangling: swings from where it's held, trailing behind as it's moved, legs kicking
            const vx = (x - lastX) / dt;
            lastX = x;
            swing += (clamp(vx * 0.07, -30, 30) - swing) * Math.min(1, dt * 8);
            sprite.style.rotate = `${swing}deg`;
            if (Math.abs(vx) > 40) facing = vx < 0 ? v.left : v.right;
            walkTime += dt * 1000;
            show(facing[Math.floor(walkTime / ((v.stepMs ?? STEP_MS) * 0.6)) % facing.length]);
            return;
          }
          if (fall) {
            fall.t = Math.min(1, fall.t + dt / FALL_S);
            const { from, to, t } = fall;
            x = from.x + (to.x - from.x) * t;
            y = from.y + (to.y - from.y) * t;
            lift = LIFT * (1 - t * t);
            swing *= 1 - Math.min(1, dt * 12);
            sprite.style.rotate = `${swing}deg`;
            if (t === 1) land(now);
            place();
            return;
          }
          if (!path.length && now >= restUntil) wander();
          if (path.length) {
            const target = path[0];
            const dx = target.x - x, dy = target.y - y;
            const dist = Math.hypot(dx, dy);
            if (dist < 2) {
              path.shift();
              if (!path.length) rest(now);
            } else {
              const move = Math.min(dist, (v.speed ?? SPEED) * dt);
              x += (dx / dist) * move;
              y += (dy / dist) * move;
              // Face the way they're heading. Going straight up or down keeps whichever side they
              // last faced and walks the same way, just moving up or down the screen.
              if (Math.abs(dx) > 4) facing = dx < 0 ? v.left : v.right;
              walkTime += dt * 1000;
              const stepMs = v.stepMs ?? STEP_MS;
              show(facing[Math.floor(walkTime / stepMs) % facing.length]);
              // Waddle: rock from foot to foot (one full rock every two steps), tipped a little toward
              // the direction of travel
              if (v.waddle) {
                const lean = (facing === v.left ? -1 : 1) * v.waddle * 0.4;
                const rock = Math.sin((walkTime / stepMs) * Math.PI) * v.waddle;
                sprite.style.rotate = `${lean + rock}deg`;
              }
            }
          }
          place();
        },
      };
    });

    const toMap = (e: MouseEvent): Point => {
      const box = map.getBoundingClientRect();
      return { x: (e.clientX - box.left) / scale, y: (e.clientY - box.top) / scale };
    };

    // ---------- Building cards ----------
    // Hover over a building (or tap it) and a little card about it pops up above it. Only the drawn part
    // counts, not the empty corners of its picture, so each picture's see-through-ness is read once it loads.
    const card = map.querySelector<HTMLElement>('[data-card]')!;
    const cardName = card.querySelector<HTMLElement>('[data-card-name]')!;
    const cardAbout = card.querySelector<HTMLElement>('[data-card-about]')!;
    const canHover = matchMedia('(hover: hover)');
    const buildings = [...map.querySelectorAll<HTMLImageElement>('[data-building]')].map((img) => {
      const b = BUILDINGS[Number(img.dataset.building)];
      const spot = { img, b, box: placed(b), z: Number(img.style.zIndex), alpha: null as Uint8ClampedArray | null };
      const read = () => {
        try {
          const c = document.createElement('canvas');
          [c.width, c.height] = b.size;
          const ctx = c.getContext('2d', { willReadFrequently: true })!;
          ctx.drawImage(img, 0, 0, c.width, c.height);
          spot.alpha = ctx.getImageData(0, 0, c.width, c.height).data;
        } catch {
          // Can't read it; the whole picture's box counts instead
        }
      };
      if (img.complete && img.naturalWidth) read();
      else img.addEventListener('load', read, { once: true });
      return spot;
    });
    type Spot = (typeof buildings)[number];
    // The building drawn at map point p (the frontmost, if they overlap)
    const buildingAt = (p: Point) =>
      buildings
        .filter(({ b, box, alpha }) => {
          const px = Math.floor((p.x - box.left) / b.scale), py = Math.floor((p.y - box.top) / b.scale);
          if (px < 0 || py < 0 || px >= b.size[0] || py >= b.size[1]) return false;
          return !alpha || alpha[(py * b.size[0] + px) * 4 + 3] > 60;
        })
        .sort((a, c) => c.z - a.z)[0];

    let shown: Spot | undefined;
    let cardTimer = 0;
    const hideCard = () => {
      clearTimeout(cardTimer);
      if (!shown) return;
      shown.img.classList.remove('is-hovered');
      card.classList.remove('is-showing');
      shown = undefined;
    };
    const showCard = (spot: Spot) => {
      clearTimeout(cardTimer);
      if (shown === spot) return;
      hideCard();
      shown = spot;
      cardName.textContent = spot.b.name;
      cardAbout.textContent = spot.b.about;
      spot.img.classList.add('is-hovered');
      // To the left of the building, level with its middle, kept inside the map (on a narrow map it
      // may overlap the building's left side a little rather than go off the edge)
      const { left, top, w, h } = spot.box;
      const gap = 10, inset = w * 0.08; // the pictures have a little empty space around the drawing
      card.style.left = `${Math.max((left + inset) * scale - gap, card.offsetWidth + 8)}px`;
      const halfH = card.offsetHeight / 2 + 8;
      card.style.top = `${clamp((top + h / 2) * scale, halfH, map.clientHeight - halfH)}px`;
      card.classList.add('is-showing');
    };

    // ---------- Picking villagers up ----------
    // Press on a villager and move, and it's lifted up and carried along until you let go. (Just
    // tapping it still says hi, through the click handler below.)
    let drag: { w: (typeof walkers)[number]; id: number; from: Point; startX: number; startY: number; lifted: boolean } | null = null;
    let dragged = false; // swallow the click that follows letting go of a carried villager
    for (const w of walkers) {
      w.sprite.addEventListener('pointerdown', (e) => {
        if (drag || e.button !== 0) return;
        e.preventDefault();
        w.sprite.setPointerCapture(e.pointerId);
        drag = { w, id: e.pointerId, from: toMap(e), startX: e.clientX, startY: e.clientY, lifted: false };
      });
    }
    map.addEventListener('pointerdown', () => (dragged = false), true);
    map.addEventListener('pointermove', (e) => {
      if (drag && e.pointerId === drag.id) {
        if (!drag.lifted && Math.hypot(e.clientX - drag.startX, e.clientY - drag.startY) > 6) {
          drag.lifted = true;
          drag.w.pickUp(drag.from);
          hideCard();
          map.classList.add('is-carrying');
        }
        if (drag.lifted) drag.w.carry(toMap(e));
        return;
      }
      if (e.pointerType !== 'mouse') return;
      // Hovering over a villager standing in front of a building is about the villager, not the building
      const spot = (e.target as HTMLElement).closest('[data-sprite]') ? undefined : buildingAt(toMap(e));
      if (spot) showCard(spot);
      else hideCard();
    });
    const letGo = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.lifted) {
        drag.w.drop();
        dragged = true;
        map.classList.remove('is-carrying');
      }
      drag = null;
    };
    map.addEventListener('pointerup', letGo);
    map.addEventListener('pointercancel', letGo);
    map.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse' && !drag) hideCard();
    });

    // Tap a villager and it says hi. Tap a building to see its card (on touch screens; with a mouse
    // it's already up from hovering). Click (or tap) anywhere else in the clearing and the closest
    // villager that can get there walks over.
    map.addEventListener('click', (e) => {
      if (dragged) {
        dragged = false;
        return;
      }
      const tapped = walkers.map((w) => ({ w, depth: w.hit(e.clientX, e.clientY) })).filter((t) => t.depth >= 0);
      if (tapped.length) {
        tapped.sort((a, b) => b.depth - a.depth)[0].w.greet();
        return;
      }
      const p = toMap(e);
      const spot = buildingAt(p);
      if (spot) {
        showCard(spot);
        if (!canHover.matches) cardTimer = window.setTimeout(hideCard, CARD_MS);
        return;
      }
      if (!canHover.matches) hideCard();
      if (reduceMotion.matches) return;
      const byDistance = [...walkers].sort((a, b) => a.distanceTo(p) - b.distanceTo(p));
      for (const w of byDistance) if (w.goTo(p)) break;
    });

    new ResizeObserver(() => {
      scale = map.clientWidth / MAP.width;
      walkers.forEach((w) => w.resize());
      hideCard();
    }).observe(map);

    if (!reduceMotion.matches) {
      let last = performance.now();
      const frame = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        for (const w of walkers) w.tick(now, dt);
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

