---
// Top navigation: name on the left, the four tabs on the right. Highlights the tab for the current page.
const tabs = [
  { href: '/', label: 'Works' },
  { href: '/village', label: 'Village' },
  { href: '/art', label: 'Art' },
  { href: '/about', label: 'About' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
// Works is the home page, and project pages (/works/...) count as Works too.
const isActive = (href: string) =>
  href === '/' ? path === '/' || path.startsWith('/works') : path.startsWith(href);
---

<header>
  <nav>
    <a class="name" href="/">Reewin Shi</a>
    <ul>
      {tabs.map((tab) => (
        <li>
          <a href={tab.href} aria-current={isActive(tab.href) ? 'page' : undefined}>
            {isActive(tab.href) && (
              <svg class="leaf" viewBox="0 0 20 12" aria-hidden="true">
                <path d="M10 11V6M10 6C8 2 4 1.5 2 3c1.5 3 5 4 8 3zM10 6c2-3.5 6-4 8-2.5-1.5 2.8-5 3.8-8 2.5z" />
              </svg>
            )}
            {tab.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  /* Spans the whole window, name at the left edge and tabs at the right. Sized in em, so on big screens the bar grows along with the page (see the html font-size in global.css) */
  header {
    border-bottom: 1px dashed var(--line);
    padding: 1em var(--edge);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75em 1.5em;
  }
  .name {
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.35em;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  ul {
    display: flex;
    gap: 0.5em;
    list-style: none;
    margin: 0 -0.7em 0 0; /* so the last tab's word, not its padding, ends at the edge */
    padding: 0;
  }
  /* Tabs are plain words in the same soft serif as the name: green, and dark ink for the current page */
  ul a {
    position: relative;
    display: block;
    padding: 0.35em 0.7em;
    color: var(--moss);
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    font-size: 1.08em;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  ul a:hover {
    color: var(--accent-ink);
  }
  ul a[aria-current='page'] {
    color: var(--text);
  }
  /* A tiny two-leaf sprout above the current page, which pops up when the page loads */
  .leaf {
    position: absolute;
    left: 50%;
    top: -0.45em;
    width: 1.3em;
    translate: -50% 0;
    fill: #a9c48a;
    stroke: var(--accent);
    stroke-width: 1.2;
    stroke-linejoin: round;
    stroke-linecap: round;
    transform-origin: 50% 100%;
    animation: sprout 0.5s 0.15s ease-out backwards;
  }
  @keyframes sprout {
    from {
      scale: 0.2;
      opacity: 0;
    }
    70% {
      scale: 1.15;
    }
  }
  /* Phones: the four tabs stay on one line under the name */
  @media (max-width: 30rem) {
    ul {
      gap: 0;
    }
    ul a {
      padding-inline: 0.6em;
    }
    ul li:first-child a {
      padding-left: 0;
    }
    ul li:first-child .leaf {
      left: calc(50% - 0.3em);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .leaf {
      animation: none;
    }
  }
</style>
