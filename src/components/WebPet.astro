---
// A villager that wanders along the bottom of the screen like a little web pet. It uses the
// villager's Village walk sheet: walks a bit, rests (sometimes playing its idle), and hops with a
// heart when clicked. Under reduced motion it just sits in the corner.
import { statSync } from 'node:fs';
import { villagers } from '../data/villagers';

interface Props {
  villager: string;
}

const key = Astro.props.villager;
const friend = villagers[key];
const v = friend?.village;
const sheet = v && `${v.sheet}?v=${Math.round(statSync(`public${v.sheet}`).mtimeMs)}`;
---

{v && (
  <div
    class="pet"
    data-pet={JSON.stringify(v)}
    style={`--frames: ${v.frames}; --fw: ${v.width}; --fh: ${v.height}`}
  >
    <span class="shadow" aria-hidden="true"></span>
    <button
      type="button"
      class="sprite"
      style={`background-image: url(${sheet}); background-position-x: ${(v.rest / (v.frames - 1)) * 100}%`}
      aria-label={`${friend.name}, say hi`}
      title={friend.name}
    ></button>
    <span class="heart" aria-hidden="true">♥</span>
  </div>
)}

<script>
  import type { Villager } from '../data/villagers';

  const SPEED = 55; // px per second
  const STEP_MS = 170;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');

  for (const el of document.querySelectorAll<HTMLElement>('[data-pet]')) {
    const v: Villager['village'] = JSON.parse(el.dataset.pet!);
    const sprite = el.querySelector<HTMLElement>('.sprite')!;
    const show = (frame: number) => {
      sprite.style.backgroundPositionX = `${(frame / (v.frames - 1)) * 100}%`;
    };

    const margin = 16;
    const maxX = () => Math.max(margin, window.innerWidth - el.offsetWidth - margin);
    let x = margin + 24;
    let target: number | null = null;
    let facing = v.right;
    let restUntil = performance.now() + 1500;
    let walkTime = 0;
    let idleTimer = 0;

    const place = () => {
      x = Math.min(Math.max(x, margin), maxX());
      el.style.translate = `${x}px 0`;
    };

    const rest = (now: number) => {
      target = null;
      sprite.style.rotate = '';
      if (v.restRight !== undefined && facing === v.right) show(v.restRight);
      else show(v.rest);
      restUntil = now + 2500 + Math.random() * 5000;
      if (Math.random() < 0.6 && !(v.restRight !== undefined && facing === v.right)) {
        let i = 0;
        const next = () => {
          if (target !== null || i === v.idle.length) return;
          const [frame, ms] = v.idle[i++];
          show(frame);
          idleTimer = window.setTimeout(next, ms);
        };
        idleTimer = window.setTimeout(next, 500);
      }
    };

    // Stroll somewhere along the bottom: usually a short way, sometimes across the screen
    const wander = () => {
      const span = maxX() - margin;
      const dist = (Math.random() < 0.75 ? 0.12 + Math.random() * 0.2 : 0.4 + Math.random() * 0.4) * span;
      const dir = x + dist > maxX() ? -1 : x - dist < margin ? 1 : Math.random() < 0.5 ? -1 : 1;
      target = x + dir * dist;
      clearTimeout(idleTimer);
    };

    // Click: a little hop and a heart
    sprite.addEventListener('click', () => {
      el.classList.remove('is-happy');
      void el.offsetWidth; // restart the animation
      el.classList.add('is-happy');
      if (target !== null) rest(performance.now());
    });
    const heart = el.querySelector<HTMLElement>('.heart')!;
    heart.addEventListener('animationend', () => el.classList.remove('is-happy'));

    show(v.rest);
    place();
    window.addEventListener('resize', place);

    if (!reduceMotion.matches) {
      let last = performance.now();
      const frame = (now: number) => {
        const dt = Math.min((now - last) / 1000, 0.1);
        last = now;
        if (!document.hidden) {
          if (target === null && now >= restUntil) wander();
          if (target !== null) {
            const dx = target - x;
            if (Math.abs(dx) < 2) rest(now);
            else {
              x += Math.sign(dx) * Math.min(Math.abs(dx), (v.speed ?? SPEED) * dt);
              facing = dx < 0 ? v.left : v.right;
              walkTime += dt * 1000;
              const stepMs = v.stepMs ?? STEP_MS;
              show(facing[Math.floor(walkTime / stepMs) % facing.length]);
              if (v.waddle) {
                const lean = (facing === v.left ? -1 : 1) * v.waddle * 0.4;
                sprite.style.rotate = `${lean + Math.sin((walkTime / stepMs) * Math.PI) * v.waddle}deg`;
              }
            }
            place();
          }
        }
        requestAnimationFrame(frame);
      };
      requestAnimationFrame(frame);
    }
  }
</script>

<style>
  .pet {
    position: fixed;
    left: 0;
    bottom: 0;
    z-index: 20;
    /* Every villager drawn at the same scale: about 4.5rem tall for a 386px-tall frame */
    height: calc(4.5rem * var(--fh) / 386);
    aspect-ratio: var(--fw) / var(--fh);
    pointer-events: none;
  }
  .sprite {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: no-repeat 0 0 / calc(var(--frames) * 100%) 100%;
    transform-origin: 50% 100%;
    cursor: pointer;
    pointer-events: auto;
  }
  .shadow {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -1%;
    height: 7%;
    border-radius: 50%;
    background: rgb(60 90 40 / 0.2);
  }
  .heart {
    position: absolute;
    left: 50%;
    top: -0.4rem;
    translate: -50% 0;
    color: #e48b8b;
    font-size: 1.1rem;
    opacity: 0;
  }
  .is-happy .sprite {
    animation: hop 0.5s ease-out;
  }
  .is-happy .heart {
    animation: heart 1.1s ease-out;
  }
  @keyframes hop {
    30% {
      translate: 0 -18%;
    }
    60% {
      translate: 0 0;
    }
    75% {
      translate: 0 -6%;
    }
  }
  @keyframes heart {
    15% {
      opacity: 1;
    }
    to {
      opacity: 0;
      translate: -50% -1.6rem;
    }
  }

  @media (max-width: 36rem) {
    .pet {
      height: calc(3.5rem * var(--fh) / 386);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-happy .sprite,
    .is-happy .heart {
      animation: none;
    }
  }
</style>
