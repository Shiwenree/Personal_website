---
// Site footer, shown at the bottom of every page via BaseLayout.
import { contact } from '../data/contact';

const links = [contact.email, contact.linkedin];
---

<footer>
  <div class="inner">
    <p>Thanks for stopping by the village.</p>
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            title={l.text}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px dashed var(--line);
    padding: 1.75rem var(--gutter);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  p {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    color: var(--muted);
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Small green uppercase words; the word itself is the link (hover shows the address) */
  a {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--moss);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--accent-ink);
  }
</style>
