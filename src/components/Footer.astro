---
// Site footer, shown at the bottom of every page via BaseLayout.
import { contact } from '../data/contact';

const links = [contact.email, contact.linkedin];
---

<footer>
  <div class="inner">
    <div class="note">
      <p>Thanks for stopping by the village.</p>
      <!-- A little sign-off; the heart is drawn a bit wobbly on purpose, to match the art -->
      <p class="signoff">
        Hand-drawn by yours truly
        <svg class="heart" viewBox="0 0 24 22" aria-hidden="true">
          <path d="M12 20.2C7.4 16.9 2.6 13.3 2.4 8.1 2.3 4.9 4.6 2.6 7.4 2.7c2 .1 3.6 1.4 4.5 3.2.9-1.9 2.6-3.3 4.7-3.3 2.9 0 5.1 2.4 4.9 5.6-.3 5.1-5 8.8-9.5 12z" />
        </svg>
      </p>
    </div>
    <ul>
      {links.map((l) => (
        <li>
          <a
            href={l.href}
            title={l.text}
            target={l.href.startsWith('http') ? '_blank' : undefined}
            rel="noopener"
          >
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </div>
</footer>

<style>
  footer {
    border-top: 1px dashed var(--line);
    padding: 1.75rem var(--gutter);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: var(--max-width);
    margin: 0 auto;
  }
  p {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings: 'SOFT' 100;
    color: var(--muted);
  }
  .signoff {
    margin-top: 0.2rem;
    font-size: 0.85rem;
    font-style: italic;
  }
  .heart {
    width: 0.85em;
    height: 0.85em;
    margin-left: 0.15em;
    vertical-align: -0.08em;
    fill: var(--accent);
    stroke: var(--accent-ink);
    stroke-width: 1.5;
    stroke-linejoin: round;
    rotate: -8deg;
  }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Small green uppercase words; the word itself is the link (hover shows the address) */
  a {
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--moss);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  a:hover {
    color: var(--accent-ink);
  }
</style>
