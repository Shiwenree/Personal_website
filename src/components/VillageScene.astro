---
// The village, drawn from above at an angle (3/4 view): forest all around an open grassy
// clearing with paths between the buildings, styled after the Works painting. All shapes built from
// code; the buildings themselves are the hand-drawn pictures placed on top in src/pages/village.astro.
// Two layers: `back` is everything villagers walk in front of; `front` is the row of trees along the
// bottom edge that villagers walk behind.
import { MAP, FOREST_EDGE, PATHS } from '../data/village-map';

interface Props {
  layer: 'back' | 'front';
}
const { layer } = Astro.props;

function seeded(seed: number) {
  return () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = seeded(23);
const between = (a: number, b: number) => a + rand() * (b - a);
const n = (v: number) => v.toFixed(1);

// Colors sampled from the Works painting (Backgrounds/Works_background.png), so the village matches it
const INK = '#4a703a'; // the painting's dark green outline
// [fill, lighter top-left highlight]
const TREE = [
  ['#97b667', '#adc982'],
  ['#94b276', '#a9c48e'],
  ['#a2c593', '#b8d6ab'],
  ['#8aab5c', '#a1c075'],
];
const MUSTARD = ['#e7d58a', '#f0e3a8']; // the occasional yellow tree

// ---------- Trees ----------
// Like the painting: no trunks, just soft shapes with a lumpy (scalloped) outline: a row of outward
// bumps from the bottom-left corner up over the top and down to the bottom-right corner, then a flat
// base along the ground. Two kinds: tall rounded columns, and wide low bushes.
function lumpy(x: number, y: number, w: number, h: number, bumps: number) {
  const cx = x, cy = y - h / 2, rx = w / 2, ry = h / 2;
  const base = y - 2;
  // Corners of the flat base, then points around the sides and top (angles go clockwise on screen)
  const from = Math.PI - 0.55, to = 2 * Math.PI + 0.55;
  const gaps = Array.from({ length: bumps }, () => between(0.75, 1.3));
  const total = gaps.reduce((a, b) => a + b, 0);
  const pts: [number, number][] = [[cx - rx * 0.86, base]];
  let a = from;
  for (const g of gaps.slice(0, -1)) {
    a += (g / total) * (to - from);
    pts.push([cx + rx * Math.cos(a), Math.min(cy + ry * Math.sin(a), base)]);
  }
  pts.push([cx + rx * 0.86, base]);
  let d = `M ${n(pts[0][0])} ${n(pts[0][1])}`;
  for (let i = 1; i < pts.length; i++) {
    const [px, py] = pts[i - 1], [qx, qy] = pts[i];
    const r = (Math.hypot(qx - px, qy - py) / 2) * between(1.02, 1.2);
    d += ` A ${n(r)} ${n(r)} 0 0 1 ${n(qx)} ${n(qy)}`;
  }
  return d + ' Z'; // straight line back along the ground
}

function tree(x: number, y: number, s: number, tall: boolean, c: string[]) {
  const w = (tall ? between(44, 58) : between(70, 92)) * s;
  const h = (tall ? between(92, 128) : between(44, 60)) * s;
  const bumps = tall ? 13 + Math.floor(rand() * 4) : 10 + Math.floor(rand() * 3);
  const shape = lumpy(x, y, w, h, bumps);
  // A softer, lighter patch toward the top left, like light falling on it
  const hl = lumpy(x - w * 0.12, y - h * 0.22, w * 0.62, h * 0.6, bumps - 3);
  return (
    `<ellipse cx="${n(x + 4)}" cy="${n(y)}" rx="${n(w * 0.58)}" ry="${n(8 * s)}" fill="#86a65a" opacity="0.35"/>` +
    `<path d="${shape}" fill="${c[0]}" stroke="${INK}" stroke-width="2.4" stroke-linejoin="round"/>` +
    `<path d="${hl}" fill="${c[1]}" opacity="0.5"/>`
  );
}

// Scatter trees on a jittered grid, keeping only the spots outside the clearing
type Item = { x: number; y: number; svg: string };
const trees: Item[] = [];
for (let gy = -10; gy <= MAP.height + 90; gy += 58) {
  for (let gx = -40; gx <= MAP.width + 40; gx += 62) {
    const x = gx + between(-20, 20) + (Math.round(gy / 58) % 2) * 31;
    const y = gy + between(-16, 16);
    const dx = (x - FOREST_EDGE.cx) / FOREST_EDGE.rx;
    const dy = (y - FOREST_EDGE.cy) / FOREST_EDGE.ry;
    const d = dx * dx + dy * dy;
    if (d < 1 + rand() * 0.12) continue;
    const tall = rand() < 0.58;
    const color = rand() < 0.12 ? MUSTARD : TREE[Math.floor(rand() * TREE.length)];
    trees.push({ x, y, svg: tree(x, y, between(0.9, 1.2), tall, color) });
  }
}
trees.sort((a, b) => a.y - b.y);
// Villagers never walk below ~880, so trees rooted lower than this are drawn in front of them
const FRONT_FROM = 800;
const backTrees = trees.filter((t) => t.y <= FRONT_FROM);
const frontTrees = trees.filter((t) => t.y > FRONT_FROM).map((t) => t.svg).join('');

// A random spot in the clearing (r = 0 center, 1 the forest edge)
const inClearing = (maxR: number) => {
  const a = rand() * Math.PI * 2;
  const r = Math.sqrt(rand()) * maxR;
  return { x: FOREST_EDGE.cx + Math.cos(a) * r * FOREST_EDGE.rx, y: FOREST_EDGE.cy + Math.sin(a) * r * FOREST_EDGE.ry };
};

// ---------- Grass ----------
// Soft blurry blade strokes, like the brushy grass in the painting (a light scattering)
const strokes = Array.from({ length: 70 }, () => {
  const { x, y } = inClearing(0.98);
  const len = between(12, 34);
  return `<ellipse cx="${n(x)}" cy="${n(y)}" rx="${n(len)}" ry="${n(between(1.6, 3))}" transform="rotate(${n(between(-110, -70))} ${n(x)} ${n(y)})" fill="${rand() < 0.7 ? '#9fbd68' : '#dbe9ac'}"/>`;
}).join('');

// Tufts, like the painting's: a few long, tapered blades that curve and lean the same way. Most are
// soft and blurry (painted), a few get a crisp dark ink blade or two on top. Sparse, and a bit thicker
// along the forest edge.
function blade(x: number, y: number, len: number, lean: number, wid: number) {
  // A thin curved leaf: up from the base, bending toward `lean`, tapering to a point
  const tx = x + lean * len, ty = y - len;
  const mx = x + lean * len * 0.25, my = y - len * 0.6;
  return `M ${n(x - wid)} ${n(y)} Q ${n(mx - wid * 0.6)} ${n(my)} ${n(tx)} ${n(ty)} Q ${n(mx + wid * 0.6)} ${n(my)} ${n(x + wid)} ${n(y)} Z`;
}
function tuft(x: number, y: number, s: number, ink: boolean) {
  const lean = between(-0.5, 0.5);
  const blades = 3 + Math.floor(rand() * 3);
  let soft = '', crisp = '';
  for (let i = 0; i < blades; i++) {
    const off = (i - (blades - 1) / 2) * 3.5 * s;
    const len = between(16, 30) * s * (Math.abs(off) > 4 ? 0.75 : 1);
    soft += blade(x + off, y, len, lean + off * 0.03 + between(-0.15, 0.15), 2.6 * s);
  }
  if (ink) {
    for (let i = 0; i < 1 + Math.floor(rand() * 2); i++)
      crisp += blade(x + between(-4, 4) * s, y, between(18, 30) * s, lean + between(-0.2, 0.2), 1.1 * s);
  }
  return { soft: `<path d="${soft}"/>`, crisp: crisp && `<path d="${crisp}"/>` };
}
const tuftList = [
  ...Array.from({ length: 22 }, () => inClearing(0.88)),
  ...Array.from({ length: 26 }, () => {
    const a = rand() * Math.PI * 2;
    const r = between(0.92, 1.0);
    return { x: FOREST_EDGE.cx + Math.cos(a) * r * FOREST_EDGE.rx, y: FOREST_EDGE.cy + Math.sin(a) * r * FOREST_EDGE.ry };
  }),
].map(({ x, y }) => tuft(x, y, between(0.9, 1.4), rand() < 0.35));
const tufts =
  // Only every other tuft gets the soft painted blades (the rest are just the crisp ink ones, or nothing)
  `<g filter="url(#brush)" fill="#7f9f52" opacity="0.55">${tuftList.filter((_, i) => i % 2 === 0).map((t) => t.soft).join('')}</g>` +
  `<g fill="#4a703a" opacity="0.85">${tuftList.map((t) => t.crisp).join('')}</g>`;

// ---------- Flowers ----------
// Speckled patches of tiny dots (the painting's wildflower drifts)...
// Each patch mixes two colors, like the painting's pink-and-peach and yellow-and-peach drifts
const SPECKLE = [
  ['#f4b8d6', '#fbd3e6'],
  ['#f3d530', '#f6b49a'],
  ['#ffffff', '#fffbe0'],
  ['#f6b49a', '#f4b8d6'],
  ['#f3d530', '#ffe680'],
  ['#e3c0f0', '#f4b8d6'],
];
const speckles = Array.from({ length: 18 }, () => {
  const { x, y } = inClearing(0.88);
  const colors = SPECKLE[Math.floor(rand() * SPECKLE.length)];
  const rx = between(34, 80), ry = rx * between(0.35, 0.55);
  return Array.from({ length: Math.round(rx * 3.2) }, () => {
    const a = rand() * Math.PI * 2, r = Math.pow(rand(), 0.7); // denser toward the middle
    const color = colors[rand() < 0.75 ? 0 : 1];
    return `<circle cx="${n(x + Math.cos(a) * r * rx)}" cy="${n(y + Math.sin(a) * r * ry)}" r="${n(between(1.5, 2.8))}" fill="${color}"/>`;
  }).join('');
}).join('');

// ...and a few of the painting's cute single flowers: a round blue one with a smile, a big white
// one, and a little pink cup
function bloom(kind: number, x: number, y: number) {
  return `<g transform="translate(${n(x)} ${n(y)}) scale(1.7) translate(${n(-x)} ${n(-y)})">${bloomShape(kind, x, y)}</g>`;
}
function bloomShape(kind: number, x: number, y: number) {
  const stem = `<path d="M ${n(x)} ${n(y)} q -1 -6 0 -12" stroke="#5d8545" stroke-width="1.6" fill="none" stroke-linecap="round"/>`;
  if (kind === 0)
    return (
      stem +
      `<circle cx="${n(x)}" cy="${n(y - 17)}" r="7" fill="#b5daf2" stroke="#4f86ad" stroke-width="1.4"/>` +
      `<path d="M ${n(x - 2.6)} ${n(y - 17)} q 2.6 2.4 5.2 0" stroke="#4f86ad" stroke-width="1.2" fill="none" stroke-linecap="round"/>`
    );
  // Leaf: a pointed oval with a dark outline, tilted out from the base
  const leaf = (lx: number, ly: number, ang: number, len: number) =>
    `<ellipse cx="${n(lx)}" cy="${n(ly)}" rx="${n(len * 0.22)}" ry="${n(len / 2)}" transform="rotate(${n(ang)} ${n(lx)} ${n(ly)})" fill="#6f9b4c" stroke="#3f6a2e" stroke-width="0.8"/>`;
  if (kind === 1) {
    // Big white flower, as in the painting: one soft lumpy blob (lobes merged into a single outline),
    // a golden outline, a little yellow dash in the middle, and two long leaves
    const cx = x, cy = y - 22, lobes = 5;
    let d = '';
    for (let i = 0; i <= lobes; i++) {
      const a = (i / lobes) * Math.PI * 2 - Math.PI / 2 + 0.3;
      const px = cx + Math.cos(a) * 7.6 * (i % 2 ? 1.08 : 0.94), py = cy + Math.sin(a) * 6.6;
      d += i === 0 ? `M ${n(px)} ${n(py)}` : ` A ${i % 2 ? 5.6 : 5} ${i % 2 ? 5.6 : 5} 0 0 1 ${n(px)} ${n(py)}`;
    }
    return (
      `<path d="M ${n(x)} ${n(y)} q -1 -7 0 -14" stroke="#3f6a2e" stroke-width="1" fill="none" stroke-linecap="round"/>` +
      leaf(x - 4.5, y - 6, -30, 13) +
      leaf(x + 5, y - 7, 30, 15) +
      `<path d="${d} Z" fill="#fbfcf0" stroke="#d9b464" stroke-width="0.9" stroke-linejoin="round"/>` +
      `<ellipse cx="${n(cx)}" cy="${n(cy + 0.8)}" rx="2.6" ry="0.9" fill="#e2bf45"/>`
    );
  }
  // Little pink flower, as in the painting: a round puff with a purple outline and a short dash
  // across the middle, sitting on two small leaves (no stem)
  return (
    leaf(x - 2.4, y - 4, -12, 8) +
    leaf(x + 3, y - 4, 28, 8) +
    `<path d="M ${n(x - 6)} ${n(y - 11)} q 0 -5 6 -5.2 q 6.4 0.2 6 5 q -0.6 3.8 -6 3.8 q -6 0 -6 -3.6 z" fill="#f2c2ec" stroke="#8e5a9c" stroke-width="1"/>` +
    `<path d="M ${n(x - 2)} ${n(y - 12)} h 4" stroke="#8e5a9c" stroke-width="1" stroke-linecap="round"/>`
  );
}
// ---------- Paths ----------
// Dirt paths: the main road up the middle, and each building's path from its door to where it joins
// another. Drawn like the building art: a near-black ink outline that wobbles a little and breaks here
// and there like a hand-drawn line, a warm sandy fill shaded darker along the far edge, a few outlined
// pebbles and little ink dashes on top (like the bookshop's stepping stones and the marks on the
// garden's soil), and grass tufts over the edges.
type P = [number, number];
// Catmull-Rom through the points, as cubic curves: [start, control 1, control 2, end] for each piece
function curves(pts: P[]) {
  return pts.slice(0, -1).map((p1, i): P[] => {
    const p0 = pts[i - 1] ?? p1, p2 = pts[i + 1], p3 = pts[i + 2] ?? p2;
    return [p1, [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6], [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6], p2];
  });
}
const bez = ([a, b, c, d]: P[], t: number): P => {
  const u = 1 - t;
  return [0, 1].map((k) => u * u * u * a[k] + 3 * u * u * t * b[k] + 3 * u * t * t * c[k] + t * t * t * d[k]) as P;
};
const INK_PATH = '#2b2622'; // the drawing's ink
const SAND_SHADE = '#d2ad74', SAND = '#e6cb95';
// Half the path's width at a height on the map: wider near the bottom (closer to us) and narrower
// toward the top (further away), like the buildings' 3/4 view
const halfWidth = (y: number) => 10.5 + 9 * Math.min(Math.max((y - 330) / 650, 0), 1);

// Each path as a filled outline instead of an even-width line: walk along it, and on both sides put
// the edge out at the path's half width, nudged in and out a little so the edges are uneven like a
// worn dirt path. Round at both ends.
function sampled(cs: P[][]) {
  const pts: P[] = [];
  for (const c of cs) {
    const steps = Math.max(4, Math.round(Math.hypot(c[3][0] - c[0][0], c[3][1] - c[0][1]) / 5));
    for (let i = pts.length ? 1 : 0; i <= steps; i++) pts.push(bez(c, i / steps));
  }
  return pts;
}
function outline(pts: P[], scale: number, dy: number) {
  // Smooth bumps along each edge (a couple of sine waves with random phases), different on each side
  const ph = Array.from({ length: 4 }, () => rand() * Math.PI * 2);
  const bump = (s: number, side: number) =>
    1 + 0.13 * Math.sin(s / 26 + ph[side * 2]) + 0.08 * Math.sin(s / 9 + ph[side * 2 + 1]);
  const left: P[] = [], right: P[] = [];
  let s = 0;
  pts.forEach(([x, y], i) => {
    const [ax, ay] = pts[Math.max(i - 1, 0)], [bx, by] = pts[Math.min(i + 1, pts.length - 1)];
    const len = Math.hypot(bx - ax, by - ay) || 1;
    const nx = -(by - ay) / len, ny = (bx - ax) / len;
    if (i) s += Math.hypot(x - pts[i - 1][0], y - pts[i - 1][1]);
    const w = halfWidth(y) * scale;
    left.push([x + nx * w * bump(s, 0), y + ny * w * bump(s, 0) + dy]);
    right.push([x - nx * w * bump(s, 1), y - ny * w * bump(s, 1) + dy]);
  });
  // Round ends: half circles from one edge to the other
  const cap = ([x, y]: P, [fx, fy]: P, from: P, steps = 7): P[] => {
    const a0 = Math.atan2(from[1] - dy - y, from[0] - x), dir = Math.atan2(fy - y, fx - x);
    const turn = Math.sin(dir - a0) > 0 ? -1 : 1; // go round the side away from the path
    const r = Math.hypot(from[0] - x, from[1] - dy - y);
    return Array.from({ length: steps }, (_, k) => {
      const a = a0 + (turn * Math.PI * (k + 1)) / (steps + 1);
      return [x + Math.cos(a) * r, y + Math.sin(a) * r + dy] as P;
    });
  };
  const last = pts.length - 1;
  const ring = [
    ...left,
    ...cap(pts[last], pts[last - 1], left[last]),
    ...right.reverse(),
    ...cap(pts[0], pts[1], right[right.length - 1]),
  ];
  return 'M ' + ring.map(([x, y]) => `${n(x)} ${n(y)}`).join(' L ') + ' Z';
}
const pathCurves = PATHS.map(curves);
const pathSamples = pathCurves.map(sampled);
const shapes = pathSamples.map((pts) => ({
  edge: outline(pts, 1, 0),
  // The lit part: a bit narrower and shifted toward us, so a darker band is left only along the far
  // (upper) edge, where the grass lip shades the path a little
  lit: outline(pts, 0.86, 4),
}));
// Breaks in the outline: long uneven dashes with short gaps, starting at a different spot on each path
const gappy = () =>
  `stroke-dasharray="${Array.from({ length: 6 }, () => `${n(between(40, 120))} ${n(between(6, 13))}`).join(' ')}" stroke-dashoffset="${n(between(0, 200))}"`;

// Pebbles and dashes at spots along the paths (skipping the ends, which are under the buildings)
const pathBits = pathSamples
  .flatMap((pts) => Array.from({ length: Math.max(1, Math.round(pts.length / 10)) }, () => pts[Math.floor(between(0.08, 0.92) * pts.length)]))
  .map(([px, py]) => {
    const x = px + between(-1, 1) * halfWidth(py) * 0.5, y = py + between(-1, 1) * halfWidth(py) * 0.3;
    if (rand() < 0.45) {
      // A grey pebble with an ink outline and a light highlight, like the bookshop's stepping stones
      const rx = between(3, 6) * (halfWidth(py) / 15), ry = rx * between(0.45, 0.65);
      return (
        `<ellipse cx="${n(x)}" cy="${n(y)}" rx="${n(rx)}" ry="${n(ry)}" fill="#a3a19c" stroke="${INK_PATH}" stroke-width="1.2"/>` +
        `<ellipse cx="${n(x - rx * 0.25)}" cy="${n(y - ry * 0.3)}" rx="${n(rx * 0.45)}" ry="${n(ry * 0.3)}" fill="#dedcd6"/>`
      );
    }
    // A little ink dash, like the marks on the garden's soil
    const w = between(3.5, 6.5);
    return `<path d="M ${n(x - w)} ${n(y)} q ${n(w)} ${n(-between(1.5, 3))} ${n(w * 2)} 0" stroke="#7a6243" stroke-width="1.2" fill="none" stroke-linecap="round"/>`;
  })
  .join('');

// Grass growing over the paths' edges here and there, so they sit in the ground instead of on top of it
const edgeTufts = pathSamples
  .flatMap((pts) =>
    Array.from({ length: Math.round(pts.length / 22) }, () => {
      const i = Math.floor(between(0.06, 0.94) * pts.length);
      const [x, y] = pts[i], [ax, ay] = pts[Math.max(i - 1, 0)], [bx, by] = pts[Math.min(i + 1, pts.length - 1)];
      const len = Math.hypot(bx - ax, by - ay) || 1;
      const side = rand() < 0.5 ? 1 : -1, w = halfWidth(y) * between(0.85, 1.05);
      return tuft(x - (side * (by - ay) / len) * w, y + (side * (bx - ax) / len) * w + 2, between(0.9, 1.25), true).crisp;
    }),
  )
  .join('');

const paths =
  `<g filter="url(#wobble)">` +
  shapes.map((p) => `<path d="${p.edge}" fill="none" stroke="${INK_PATH}" stroke-width="4.5" stroke-linejoin="round" ${gappy()}/>`).join('') +
  shapes.map((p) => `<path d="${p.edge}" fill="${SAND_SHADE}"/>`).join('') +
  `<g filter="url(#shade)">` +
  shapes.map((p) => `<path d="${p.lit}" fill="${SAND}"/>`).join('') +
  `</g></g>` +
  pathBits +
  `<g fill="#4a703a" opacity="0.85">${edgeTufts}</g>`;

// The single flowers grow beside the paths, never on them
const pathPoints = pathSamples.flat();
const offPath = (x: number, y: number) => pathPoints.every(([px, py]) => Math.hypot(px - x, py - y) > halfWidth(py) + 24);
const blooms = Array.from({ length: 9 }, (_, i) => {
  let spot = inClearing(0.85);
  for (let tries = 0; tries < 30 && !offPath(spot.x, spot.y); tries++) spot = inClearing(0.85);
  return bloom(i % 3, spot.x, spot.y);
}).join('');

// Trees are drawn top of the map first, so lower ones overlap them
const standing = backTrees.map((t) => t.svg).join('');

const scene = `
  <defs>
    <filter id="soft" x="-20%" y="-20%" width="140%" height="140%"><feGaussianBlur stdDeviation="40"/></filter>
    <filter id="brush" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="2.2"/></filter>
    <filter id="shade" x="-5%" y="-5%" width="110%" height="110%"><feGaussianBlur stdDeviation="1.4"/></filter>
    <filter id="wobble" x="-5%" y="-5%" width="110%" height="110%"><feTurbulence type="fractalNoise" baseFrequency="0.04" numOctaves="2" seed="7"/><feDisplacementMap in="SourceGraphic" scale="5" xChannelSelector="R" yChannelSelector="G"/></filter>
  </defs>
  <rect width="${MAP.width}" height="${MAP.height}" fill="#b5ce7d"/>
  <g filter="url(#soft)">
    <ellipse cx="${FOREST_EDGE.cx}" cy="${FOREST_EDGE.cy + 15}" rx="${FOREST_EDGE.rx * 0.95}" ry="${FOREST_EDGE.ry * 0.92}" fill="#c6db92"/>
    <ellipse cx="${FOREST_EDGE.cx - 120}" cy="${FOREST_EDGE.cy - 20}" rx="380" ry="200" fill="#d4e39f"/>
  </g>
  <g filter="url(#brush)" opacity="0.45">${strokes}</g>
  ${speckles}
  ${tufts}
  ${paths}
  ${blooms}
  ${standing}
`;
---

{
  layer === 'back' ? (
    <svg class="scene" viewBox={`0 0 ${MAP.width} ${MAP.height}`} aria-hidden="true" set:html={scene} />
  ) : (
    <svg class="scene front" viewBox={`0 0 ${MAP.width} ${MAP.height}`} aria-hidden="true" set:html={frontTrees} />
  )
}

<style>
  .scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* trees along the bottom edge: drawn over the villagers, and clicks pass through */
  .front {
    z-index: 5000;
    pointer-events: none;
  }
</style>
